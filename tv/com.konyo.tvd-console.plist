<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.konyo.tvd-console</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/konyo/d2r_bible_tests/tv/tvd_supervisor.sh</string>
    </array>

    <!-- respawn the supervisor itself if it ever dies -->
    <key>KeepAlive</key>
    <true/>

    <!-- start now and on every login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- don't thrash if it exits fast -->
    <key>ThrottleInterval</key>
    <integer>20</integer>

    <key>StandardOutPath</key>
    <string>/Users/konyo/d2r_bible_tests/tv/tvd_supervisor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/konyo/d2r_bible_tests/tv/tvd_supervisor.log</string>
</dict>
</plist>
