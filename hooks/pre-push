#!/usr/bin/env bash
# pre-push — fast critical-path Playwright smoke before a push is allowed, then
# (on a green push to main) AUTO-DEPLOY the site live to Cloudflare Pages.
#
# This hook is VERSION-CONTROLLED (repo-root hooks/) and activated via
# `core.hooksPath = hooks`. On a fresh clone run `bash hooks/install` once to
# enable it (git config is per-clone and cannot travel in the repo itself).
#
# Why the smoke gate: commits sometimes land on main without the suite being run
# (see REG-001 in BUGS.md — a central artOr() edit load-stormed the calc grid and
# broke 3 specs, only caught by CI after the fact). This gate runs a ~1-2 min
# subset covering the three central helpers (artOr / openDrop / switchTab) + the
# lazy-load invariant, so that class of breakage is caught BEFORE the remote.
#
# Why the auto-deploy: deploys are Mac-only and were a manual step. After the smoke
# gate passes, a push to main that touches bible.html / art / functions publishes
# live via deploy.sh. Ordering note: this runs in pre-push (just before the ref
# reaches the remote), so "live" is the exact state being pushed; if the network
# push were to fail afterward, the next push simply re-deploys the merged state.
# Deploy failure WARNS but never blocks the push — the remote is the source of
# truth for code; going live is a convenience on top.
#
# Scope: smoke only runs when the push touches bible.html or a *.spec.ts; deploy
# only runs for refs/heads/main touching bible.html / art / functions /
# tv/install-tvd.ps1 / deploy.sh. Docs-only pushes skip both.
#
# Emergency bypass (use sparingly):  git push --no-verify
set -u

REPO="$(git rev-parse --show-toplevel)" || exit 1
# v3465 (#193) — EVERY STATUS LINE CARRIES ITS ELAPSED TIME. Untimed, a gate's duration could
# only be BOUNDED from outside by polling ps; the v3447-v3451 prover could only be reported as
# "<=20 min". Elapsed since the hook started, from bash's own $SECONDS — no date, no fork.
# ⚠ No EXIT trap for a total: the console gate sets its own `trap ... EXIT` further down, and
# a second trap would REPLACE it silently. The last stamped line already carries the total.
_PP_T0=$SECONDS
_pp_el() { local s=$((SECONDS - _PP_T0)); printf '%dm%02ds' $((s / 60)) $((s % 60)); }

# REG-2395 - WHAT THIS PUSH SHIPS IS ASKED ONCE, HERE, BEFORE THE SCRUB BELOW, AND HANDED ON BY VALUE. The tv-suites lane
# asked `git diff @{push}..` itself, with no fallback and no word when it failed. MEASURED on speed/push-a2 (upstream
# origin/main, pushed as HEAD:main, push.default unset): `@{push}` -> "cannot resolve 'simple' push to a single
# destination", so test_agent, test_control, test_folder_scans, test_tz_art and both chronicle suites were skipped
# without a line. The base comes in the changed-law block's order - @{push}, else origin/main - with every `git -c` the
# push was given still in force: TV_PUSH_BASE (a commit; EMPTY = UNKNOWN) and TV_PUSH_RANGE (the words a line prints).
# Law: test_a_leaked_git_dir_never_writes_the_real_repo (TheTvLaneReadsAKnownRangeOrRuns).
# >>> push-range
TV_PUSH_BASE=""
if _pr_b="$(git rev-parse --verify --quiet '@{push}' 2>/dev/null)" && [ -n "$_pr_b" ]; then
  TV_PUSH_BASE="$_pr_b"
  TV_PUSH_RANGE="@{push}..HEAD (@{push} = $(git rev-parse --abbrev-ref '@{push}' 2>/dev/null))"
elif _pr_b="$(git rev-parse --verify --quiet 'origin/main' 2>/dev/null)" && [ -n "$_pr_b" ]; then
  TV_PUSH_BASE="$_pr_b"
  TV_PUSH_RANGE="origin/main..HEAD (@{push} does not resolve)"
else
  TV_PUSH_RANGE="UNKNOWN - neither @{push} nor origin/main resolves"
fi
export TV_PUSH_BASE TV_PUSH_RANGE
# <<< push-range

# REG-2360 - NO STAGE OF THIS HOOK INHERITS GIT'S POINTER AT THE REAL REPO. Git runs a pre-push hook with
# GIT_DIR exported (absolute, `<main>/.git/worktrees/<name>`, when the push comes from a linked worktree), and GIT_DIR
# beats cwd= in every git child. MEASURED on the v3783 pushes: a law that `git init`s a temp repo committed two fixture
# commits onto the push branch (pushes #10 and #11 refused), and a `git init --bare` in another rewrote his live
# checkout's common config to core.bare=true - every git command in his main tree dead for 2.5 h. The hook reads the
# one thing it needs from that pointer (the git dir, handed to the commit-stamps law by name), then unsets every
# variable git itself calls local to a repository (`git rev-parse --local-env-vars`) before any stage runs. Its own
# git calls lose nothing: git starts a hook at the top of the work tree, and discovery from there finds the same repo.
# ⚠ REG-2394 - EXCEPT THE PUSH'S OWN OPTIONS. `git -c k=v push` reaches this hook in GIT_CONFIG_PARAMETERS (and
# `GIT_CONFIG_COUNT=n GIT_CONFIG_KEY_i/VALUE_i` in COUNT), and git's list names both, so the first cut unset them:
# MEASURED on a throwaway repo, `git -c push.default=upstream push origin HEAD:main` had @{push} = origin/main before the
# loop and "cannot resolve" after it, and every later stage ran without the caller's -c. They carry options, never a
# pointer at a repository, so they stay (KEY_i/VALUE_i are not on git's list and were only orphaned by losing COUNT).
# A suite this hook runs itself keeps the push's options and never a pointer; a law heart2, run_gates, suite_verdict or
# shard_suite starts loses every GIT_* whoever started it (REG-2396).
# Law: test_a_leaked_git_dir_never_writes_the_real_repo.
# >>> scrub-git-env
TV_PUSHED_GIT_DIR="$(git rev-parse --absolute-git-dir 2>/dev/null)"
export TV_PUSHED_GIT_DIR
for _pp_v in $(git rev-parse --local-env-vars 2>/dev/null) GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; do
  case "$_pp_v" in GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT) continue ;; esac
  unset "$_pp_v"
done
# <<< scrub-git-env

# >>> fast-gate-overlap
# v3847 FAST GATE - THE CHROME-FREE SUITE RUNS BESIDE THE CHROME STAGES. test_agent starts no browser, so it runs now,
# in the background, while render / console demos use the one Chrome; the tv lane's `suite_verdict.py --check
# test_agent --wait 900` below finds this run (in flight or green on these exact bytes) instead of starting its own.
# A red or unfinished background run is not reused - the lane then runs the suite itself, as before. Never a skip.
if [ -n "${TV_PUSH_BASE:-}" ] && git diff --name-only "${TV_PUSH_BASE}..HEAD" 2>/dev/null | grep -qE '^tv/.*\.py$' \
   && [ "${SUITE_VERDICT_REUSE:-1}" != "0" ]; then
  ( cd "$REPO" && python3 "$REPO/tv/suite_verdict.py" --run test_agent >"${TMPDIR:-/tmp}/tv-prepush-agent-bg.log" 2>&1 ) &
  _fg_agent_bg=$!
  echo "pre-push: [$(_pp_el)] test_agent started beside the browser stages (pid $_fg_agent_bg, no Chrome)"
fi
# <<< fast-gate-overlap

# REG-1258 — THE GATE'S BROWSER PORT IS CHOSEN, NEVER ADOPTED. Everything below (the render block,
# render_check._chrome_up(), crest_loudness, every suite that renders) asked "does something answer
# on :9224?" and, if so, USED it. MEASURED 2026-09-24 before a push: another Claude session's
# headless Chrome held :9224 for its own web research - the gate would have opened its tabs in that
# browser, at that browser's window size, and graded the page there. A port answering is not a
# browser you own. So: the first port from 9224 up that NOTHING listens on, exported once, so every
# child of this push inherits the same private port. [[process-port-discipline]]
# >>> choose-render-port
_rp_from="${TV_RENDER_PORT_FROM:-9224}"
# his Chrome and TradingView sit just below 9224 - the scan may never start under it
[ "$_rp_from" -lt 9224 ] 2>/dev/null && _rp_from=9224
_rp_port=""
for _rp in $(seq "$_rp_from" $((_rp_from + 40))); do
  # a connect that SUCCEEDS means something listens - a browser or not, it is not ours. Bash's own
  # /dev/tcp, so no lsof/curl is needed on any OS; a closed loopback port refuses at once.
  if (exec 3<>"/dev/tcp/127.0.0.1/$_rp") 2>/dev/null; then continue; fi
  _rp_port="$_rp"; break
done
# REG-1278 — A FULL WINDOW REFUSES; IT NEVER FALLS BACK. This exported the start port when every
# port answered, and the start port is exactly the one the loop had just proved taken, so the
# render block found a browser there and graded the page in it. One busy port was skipped; a full
# window was adopted (found by the cross-family eye on #231). Nothing here is ours, so say so.
if [ -z "$_rp_port" ]; then
  echo "pre-push: [$(_pp_el)] 🔴 ports ${_rp_from}-$((_rp_from + 40)) ALL answer, so this gate cannot start a browser of"
  echo "          its own - and grading in one it did not start is REG-1258. Clear leaked scratch browsers"
  echo "          (reap) and push again."
  exit 1
fi
export TV_RENDER_PORT="$_rp_port"
# <<< choose-render-port

# v1576 — KEEP THE EVIDENCE. Every gate below used to run with `>/dev/null 2>&1`, so a
# blocked push told you only *that* a suite failed, never *which test*. The output was
# destroyed at the exact moment it became evidence, and the only remedy on offer ("run it
# by hand") is the one thing that cannot recover a FLAKY failure — by the time you re-run,
# it passes and the failing run is gone for good. That happened on the v1575 push: 340
# tests, one of them red, and no way left to learn which.
#
# gate_run <label> <human-rerun-cmd> <timeout-seconds> -- <cmd...>
#   Runs the command with output tee'd to a kept log. On failure prints the last 40 lines
#   (the unittest FAIL/ERROR block lives there) + the log path, then returns 1.
#
# v1578 — AND IT IS TIME-BOUND, because an unbounded gate is not a gate, it is a hang. The v1578
# push sat in tv/test_control.py for TEN MINUTES and was killed from outside; the kept log showed
# one F and one E and then nothing, so the suite hung after failing and gate_run never got to print
# the names. Three re-runs standalone, one after test_agent, and one under a hook-like git
# environment were all 340/340 green, so the cause is still unknown and is recorded as unknown.
# What is fixed is the SHAPE of the failure: a hung gate now dies at its limit and reports as a
# timeout with its log path, instead of blocking the push until a human gives up.
# macOS ships no coreutils `timeout`; perl does the same job with alarm+exec (SIGALRM = 142).
# GATE_RC is written by gate_run so a caller CAN tell a timeout-kill from a red result. No caller
# needs that today, and the one that used to read it never did — see the review-lite note below.
# Kept because gate_run sets it unconditionally; do NOT use it as a substitute for `exit 1`.
GATE_RC=0
GATE_LOG_DIR="${TMPDIR:-/tmp}/d2r-pre-push"
mkdir -p "$GATE_LOG_DIR" 2>/dev/null || GATE_LOG_DIR="/tmp"

gate_run() {
  label="$1"; rerun="$2"; limit="$3"; shift 4   # label, rerun, limit, and the literal --
  # REG-1993 - a caller may widen THIS gate's bound by the load it measured (GATE_SCALE, clamped 1.00-2.50). The
  # literal at the call site stays the measured base, so every law that reads it still reads the measured number.
  GATE_BASE="$limit"; export GATE_BASE       # REG-1995 - the measured bound, before any widening, for the deadline grace
  if [ -n "${GATE_SCALE:-}" ]; then
    limit="$(awk -v l="$limit" -v s="$GATE_SCALE" 'BEGIN{ s += 0; if (s < 1) s = 1; if (s > 2.5) s = 2.5; printf "%d", l * s + 0.5 }')"
  fi
  # Log name carries the label + pid so concurrent/consecutive pushes never overwrite
  # each other's evidence.
  log="$GATE_LOG_DIR/${label}.$$.log"
  # NOT `if "$@"; then return 0; fi` + `rc=$?` — after an if-block whose branch did not
  # run, $? is the *if statement's* status (0), so the report would claim "exit 0" on a
  # failure. `&& return 0` short-circuits and leaves the command's own code in $?.
  # perl forks and REAPS rather than alarm+exec. With exec, SIGALRM kills the process outright and
  # the shell prints a raw "Alarm clock: 14" into the middle of his push output (a subshell does not
  # ⚠ </dev/null ON THE CHILD (2026-08-19). A pre-push hook receives the ref lines it is judging on
  # STDIN, and the `while read local_ref local_sha remote_ref remote_sha` loop below consumes them
  # to decide what changed. Gate children inherited that same stdin, so any gate that read or
  # drained it would leave that loop at EOF: `run` and `deploy` stay 0, the smoke gate is skipped
  # as "no relevant changes", and the hook exits 0 — a push waved through by a gate that was trying
  # to help. Measured: none of the three current gates touch stdin, so this is LATENT, not live.
  # Closed anyway, because the failure mode is silent and the fix is one redirect.
  # Found by a third-eye review of this hook.
  #
  # hide it — the notice comes from whichever shell waits on the job). Forking lets the parent catch
  # ALRM, TERM the child, and exit 142 deliberately, so a timeout looks like a decision instead of a
  # crash. exit 127 mirrors the shell's own "command not found".
  perl -e 'my $t = shift;
           my $p = fork; die "fork: $!" unless defined $p;
           if (!$p) { exec @ARGV; exit 127 }
           # REG-1995: a gate its caller marked GATE_LOAD_GRACE gets ONE extension when the machine is busy AT THE DEADLINE -
           # the load that starves it may arrive after it starts (GrokBot began a tick 2 min into a render). Quiet at the
           # deadline is still a kill: a slow run on a quiet machine is the hang this bound exists for.
           my $t0 = time; my $grace = $ENV{GATE_LOAD_GRACE} ? 1 : 0; my $base = $ENV{GATE_BASE} || $t;
           $SIG{ALRM} = sub {
             if ($grace) { $grace = 0;
               my @la = split /\s+/, ((`sysctl -n vm.loadavg 2>/dev/null` =~ s/[{}]//gr) =~ s/^\s+//r); my $l = $la[0] || 0;
               my $s = $l > 5 ? $l / 5 : 1; $s = 2.5 if $s > 2.5; my $want = int($base * $s + 0.5); my $el = time - $t0;
               if ($want > $el + 1) { print STDERR "gate: busy at the deadline (load $l) - one extension to ${want}s\n"; alarm($want - $el); return; } }
             kill "TERM", $p; waitpid($p, 0); exit 142 };
           alarm $t; my $r; do { $r = waitpid($p, 0) } while ($r == -1 && $!{EINTR}); my $st = $?; alarm 0;
           # A child killed by a SIGNAL puts the signal in the LOW byte and leaves $?>>8 as 0,
           # so the old `exit($? >> 8)` reported a KILLED gate as a PASS. v1582 was SIGTERMed
           # mid-smoke; with this wrapper in front of it the push would have been waved
           # through green. A wrapper that reports success when the thing it wrapped died is
           # worse than no wrapper. 128+signal is what a shell reports, so match it.
           exit(($st & 127) ? 128 + ($st & 127) : ($st >> 8));' "$limit" "$@" </dev/null >"$log" 2>&1 && return 0
  rc=$?
  GATE_RC="$rc"        # the REAL code, for callers that must tell a kill from a red result;
                       # gate_run itself returns 1, so `rc=$?` at the call site sees 1 and a
                       # caller checking for 143 there would never fire. Found by testing the
                       # branch instead of trusting it.
  if [ "$rc" -eq 142 ]; then
    # ⚠⚠ 2026-09-16 — SAY WHETHER IT HUNG OR WAS STARVED. THE FILE ALREADY KNEW AND ONLY MOVED
    # THE CEILING. v2361 raised this 600 -> 1500 because "719s with D2R running at 110% CPU"
    # blocked every push he made while playing, and its own comment ended "the message says HUNG
    # when nothing hung" — then left the message alone. Today it killed test_control at 1500s with
    # **D2R at 181% CPU and load average 18**, on a tree whose suite had passed standalone in 529s
    # forty minutes earlier. Nothing hung. A verdict that names the wrong cause sends the next
    # reader hunting a deadlock that was never there, which is the one thing a timeout message
    # must not do.
    # ⚠ THE PUSH IS STILL BLOCKED, and that is correct: a suite that did not finish did not pass.
    # What changes is the SENTENCE, not the refusal. [[unknown-stays-unknown]] [[label-outlived-referent]]
    _load1="$(uptime | sed 's/.*averages*: *//' | awk '{print $1}' | tr -d ',')"
    _busy="$(printf '%.0f' "${_load1:-0}" 2>/dev/null || echo 0)"
    if [ "${_busy:-0}" -ge 6 ]; then
      echo "pre-push: [$(_pp_el)] ⏱ ${label} DID NOT FINISH in ${limit}s — load average ${_load1}. Push blocked."
      echo "          ⚠ STARVED, not hung: this machine was busy (load ${_load1}). The suite has"
      echo "            never wedged; it has been slowed. Re-push when the machine is quiet"
      echo "            rather than raising the ceiling — a ceiling above every real load is an"
      echo "            absent hang detector."
    else
      echo "pre-push: [$(_pp_el)] ⏱ ${label} HUNG — killed after ${limit}s on an IDLE machine (load ${_load1}). Push blocked."
    fi
    echo "          Partial output kept at: ${log}"
    echo "          ── last 25 lines before the kill ───────────────────────────"
    tail -25 "$log" | sed 's/^/          /'
    echo "          ────────────────────────────────────────────────────────────"
    return 1
  fi
  echo "pre-push: [$(_pp_el)] ❌ ${label} FAILED (exit ${rc}) — push blocked."
  echo "          Reproduce: ${rerun}"
  echo "          Full output kept at: ${log}"
  echo "          ── last 40 lines ───────────────────────────────────────────"
  tail -40 "$log" | sed 's/^/          /'
  echo "          ────────────────────────────────────────────────────────────"
  return 1
}

# v1359 — VISUAL-LOCK gate (instant, pure stdlib, no deps): the tokenized type system
# (font-weights + structure/spacing/line-height on bible.html + tv/control_ui.html) must
# never regress to a raw literal instead of a var(--fw/--hd/--ls/--lh) token. Runs on every
# push; catches drift BEFORE the remote. See LOCKED_TYPE_SYSTEM.md.  (bypass: git push --no-verify)
# ── v1778 — REVIEW BEFORE PUSH, the deterministic half ───────────────────────────────────────────
# Konyo: "yes wire it into pre-push". A git hook cannot invoke the /code-review skill (that is a
# Claude Code command, not a shell tool) and a model review on every push would spend subscription
# calls we now know are finite — so this is the half that IS enforceable: every check is a defect
# class this repo has actually shipped, with a version behind it.
#
# It earned its place on its first run by catching three real things, one of them minutes old:
# a live-state guard watching FILENAMES THAT DO NOT EXIST (chron_autoread.json was never watched),
# the vault sweep's state file isolated by no test at all, and a cap default too small to read one
# reel. The model half stays opt-in: TVD_REVIEW=1 prints an advisory read of the diff.
# 2026-08-19 — THIS GATE COULD NOT BLOCK A PUSH, AND NOTHING SAID SO.
# On failure it set GATE_RC=1 and carried on. `$GATE_RC` is never read anywhere in this file —
# grep it: assigned at three places, consumed at none. So review-lite has been ADVISORY since it
# was written, while its two siblings below (visual-lock, boss-portraits) both `exit 1` on the
# same shape. Its own comment above says it earned its place by catching three real defects on
# its first run; every one it caught after that was a line in a log nobody had to act on.
# A gate that reports and cannot refuse is the failure this repo has the most scars for.
# Found by a third-eye review of the hook. Verified before arming: `python3 tv/review_lite.py`
# exits 0 today ("review-lite clean — 6 state paths, chronicle tolerances, caps, reader guards"),
# so making it block refuses nothing that is currently green.
# ── v1966 — A COMMIT THAT NAMES A VERSION MUST CARRY THAT VERSION'S STAMPS ───────────────────────
# Konyo's rule was already written down — "A vNNNN IS A SHIP, NOT A COMMIT: number ONLY commits that
# bump the four stamps" — and nothing enforced it. On 2026-08-22 `bump_version.py v1964` REFUSED
# ("apostrophe in note/name would break the single-quoted D2R_BUILD literal"; the note said read's),
# the refusal was piped through `tail -3` in a background command and never read, and the commit went
# out titled "v1963 + v1964" with all four stamps still at v1963. Code correct, every gate and CI lane
# green — only the claim was false, and the board reported one version behind what it carried.
#
# It checks the HIGHEST version the subject names, not the first: that subject named two, and a
# first-match gate would have found v1963, matched the stamps and agreed with the mistake.
# Silent on commits that name no version — those are exactly the ones his rule says not to number.
if ! gate_run "version-stamp" "python3 tv/version_stamp_gate.py" 30 -- \
     python3 "$REPO/tv/version_stamp_gate.py"; then
  echo "          ↑ the commit subject claims a version the four stamps do not carry."
  exit 1
fi

# ── ENCODING-SAFE, IN UNDER A SECOND, BEFORE ANYTHING EXPENSIVE ───────────────────────────────
# v3293 — this rule already existed and already WORKED: it has refused lane_census.py,
# rung_accounting_wilson.py and render_check.py on their first runs (each says so in a comment),
# and it refused a test of mine this session. The defect was never the rule, it was WHEN you learn:
# it lived inside test_control, which runs ~500s in, at push time. That is the most expensive
# possible moment to discover a missing one-line import — and the crash it prevents happens WHILE
# REPORTING a failure, so on his cp1255 Windows console a clean tree exits non-zero for a reason
# that has nothing to do with what was being checked.
# It is the same definition (console_safe.audit), not a copy: tv/test_every_cli_that_prints_non_ascii_is_encoding_safe.py
# calls it too. REG-2362 moved that case out of test_control; it lists tv/ for its denominator, so no stage of this
# hook runs it, and THIS step is the audit's push-time run. The enable()-never-raises case stayed in test_control,
# which the tv suites stage below runs.
if ! python3 "$REPO/tv/console_safe.py"; then
  echo "pre-push: [$(_pp_el)] ❌ a script prints non-ASCII and never makes stdout encoding-safe — push blocked."
  echo "          Reproduce: python3 tv/console_safe.py"
  echo "          On a cp1255 console it crashes WHILE REPORTING, so a clean tree exits non-zero"
  echo "          for a reason unrelated to the check. Add at the top of the file named above:"
  echo "              from console_safe import enable; enable()"
  exit 1
fi

# ── THE SECOND EYE OWES A LOOK ────────────────────────────────────────────────────────────────
# Konyo's standing order since 2026-07-15 is one Grok pass after every ship — "its like ping pong.
# you fix and ship and then ask it what can be perfected". On 2026-08-26 v2137 through v2142 shipped
# and ZERO ran. He asked whether the second eye was going; the honest answer was no, and NOTHING HAD
# NOTICED, because nothing was keeping score. He then asked the question that produced this gate:
# "okay but now your doing it not youself? and for the future too?"
#
# A standing order that lives in my memory is one that lapses silently, exactly as the console-demo
# gate did until v2119 moved it in here. So it moves in here too.
#
# WHAT IT CHECKS: the version ALREADY ON origin/main must have been looked at by a different model
# family before a NEW version may ship. It cannot ask about the version being pushed — that one has
# not been deployed yet, by construction — so it asks about the last one, which is precisely the
# check that would have stopped six unverified ships in a row.
#
# It stays silent on a push that does not change the stamps: a test:/ci: commit is not a ship and
# does not owe anyone a look.
#
# ⚠ An unreachable eye is an EMPTY SEAT, never agreement, and a look from the family that WROTE the
# code is not a second eye — tv/second_eye_ledger.py enforces both, and refuses on "no record" too,
# because a skip is not a pass.
# v2143.1 — READ THE REF LINES ONCE, HERE, and feed both consumers from the variable. git hands a
# pre-push hook `<local_ref> <local_sha> <remote_ref> <remote_sha>` on STDIN, and until now the only
# reader was the loop near the bottom. That left the second-eye gate below guessing from the branch
# it happened to be standing on, which an adversarial pass broke in one command:
# `git push origin wip:main` publishes to main while `git rev-parse --abbrev-ref HEAD` says "wip",
# so the gate skipped itself entirely. Slurping here also closes the LATENT stdin-inheritance hazard
# this file documents at the top: with the lines in a variable, nothing a gate child does to stdin
# can leave the loop at EOF.
_PUSH_REFS="$(cat)"
# REG-2360 - THE PUSHED COMMIT, BY NAME. TestTheStampsAgreeInTheCOMMITNotJustTheWorktree asks what the bytes
# being PUSHED say. In heart2's sandbox from a worktree (then a copy with no .git) it reached that commit only through
# the GIT_DIR this hook now unsets; the sandbox's own history (REG-2364) holds HEAD, and the pushed commit need not be
# HEAD. So it is handed the commit instead: the local sha pushed to main, else the first ref that ships bytes,
# else HEAD. A deletion ships nothing. With TV_PUSHED_GIT_DIR it is read by `git --git-dir=... show <sha>:<path>`.
# >>> pushed-commit
TV_PUSHED_COMMIT=""
while read -r _pc_lr _pc_ls _pc_rr _pc_rs; do
  [ -n "$_pc_ls" ] || continue
  [ "$_pc_ls" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$_pc_rr" = "refs/heads/main" ]; then TV_PUSHED_COMMIT="$_pc_ls"; break; fi
  [ -n "$TV_PUSHED_COMMIT" ] || TV_PUSHED_COMMIT="$_pc_ls"
done <<< "$_PUSH_REFS"
[ -n "$TV_PUSHED_COMMIT" ] || TV_PUSHED_COMMIT="$(git rev-parse --verify -q HEAD 2>/dev/null)"
export TV_PUSHED_COMMIT
# REG-2456 (A2's Grok low 4) - THE STAMPS LAW READS ONE COMMIT, SO EVERY OTHER REF THAT SHIPS BYTES IS NAMED HERE. A push of
# several refs with no main ref handed it the first ref's sha and said nothing of the rest; beside main, the others were
# just as unread. A ref it does not read is said in this hook's own output, never silently passed.
_pc_unseen=""
while read -r _pc_lr _pc_ls _pc_rr _pc_rs; do
  [ -n "$_pc_ls" ] || continue
  [ "$_pc_ls" = "0000000000000000000000000000000000000000" ] && continue
  [ "$_pc_ls" = "$TV_PUSHED_COMMIT" ] && continue
  _pc_unseen="$_pc_unseen $_pc_rr@${_pc_ls:0:9}"
done <<< "$_PUSH_REFS"
if [ -n "$_pc_unseen" ]; then
  echo "pre-push: [$(_pp_el)] ⚠ this push ships more than one ref: the commit-stamps law reads ONE commit,"
  echo "          only ${TV_PUSHED_COMMIT:-?}; NOT read by it:$_pc_unseen"
fi
# <<< pushed-commit
# >>> ci-only lane (#182, his go 2026-10-06) — A PUSH WHOSE EVERY REF IS refs/heads/ci/* IS GRADED ON GITHUB.
# tv/push_lane.py reads the refs being PUSHED (never the current branch) and fails toward the FULL gate: one
# ref that is not ci/* - main above all, even a deletion of main - runs everything below exactly as before.
# A ci/* branch never deploys (publish.yml runs on main only), and nothing below this line runs for it.
# Never --no-verify, on any branch. Law: test_a_ci_push_skips_the_mac_and_never_main.
_lane="$(printf '%s\n' "$_PUSH_REFS" | python3 "$REPO/tv/push_lane.py" 2>/dev/null)" || _lane="full"
if [ "$_lane" = "ci-only" ]; then
  echo "pre-push: [$(_pp_el)] CI-ONLY PUSH - every ref is refs/heads/ci/*: this Mac graded nothing; read GitHub"
  echo "          (gh run list --branch <the ci branch>). Nothing deploys. Shipping to main still pays the full gate."
  exit 0
fi
# <<< ci-only lane
# Derive the refs being PUSHED, not the branch I happen to be standing on.
_se_local=""; _se_remote=""
while read -r _lr _ls _rr _rs; do
  [ "$_rr" = "refs/heads/main" ] || continue
  [ -z "$_ls" ] && continue
  [ "$_ls" = "0000000000000000000000000000000000000000" ] && continue   # deletion, nothing ships
  _se_local="$_ls"; _se_remote="$_rs"
done <<< "$_PUSH_REFS"

if [ -n "$_se_local" ]; then
  _se_ver_at() {   # the stamped version at a commit, or empty
    git show "$1:tv/WINDOWS_SHIP.json" 2>/dev/null \
      | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin) or {}
    v = str(d.get("ver") or "").strip()
    print(v if v else "")
except Exception:
    print("")' 2>/dev/null || true
  }
  # THE COMMIT BEING PUSHED, and THE COMMIT ALREADY ON MAIN. Not the working tree (which can hold
  # edits that are not shipping, and a reverted file made a version-bumping push look like a
  # test commit), and not the local origin/main ref (which is stale, and is simply absent in a
  # clone whose remote is not named "origin" — that skipped the gate entirely).
  _this_ver="$(_se_ver_at "$_se_local")"
  _prev_ver=""
  if [ "$_se_remote" != "0000000000000000000000000000000000000000" ] && [ -n "$_se_remote" ]; then
    _prev_ver="$(_se_ver_at "$_se_remote")"
  fi

  if [ -z "$_this_ver" ]; then
    # ⚠ UNREADABLE IS A REFUSAL, NOT A SKIP. Every way of failing to read a version used to
    # degrade to silence, so a WINDOWS_SHIP.json that would not parse DELETED this gate instead
    # of tripping it. Unknown exits non-zero here, like everywhere else in this repo.
    echo "pre-push: [$(_pp_el)] ❌ cannot read the version stamp in the commit being pushed, so I cannot tell"
    echo "          whether this is a ship. Refusing rather than guessing."
    echo "          (deliberate exception: git push --no-verify)"
    exit 1
  fi

  # ⚠ v2145 — AN EMPTY _prev_ver USED TO BE A SILENT SKIP, and the second eye measured the way
  # through: publish once with a WINDOWS_SHIP.json that parses but has no "ver" key (or one that
  # does not parse at all), and the NEXT push — a real ship — finds prev empty and the gate never
  # runs. A genuine first publish is different: the remote sha is all-zeros, there is no previous
  # version because there is no previous commit, and skipping is correct. Those two are now told
  # apart instead of sharing an exit.
  if [ -z "$_prev_ver" ] \
     && [ -n "$_se_remote" ] \
     && [ "$_se_remote" != "0000000000000000000000000000000000000000" ]; then
    echo "pre-push: [$(_pp_el)] ❌ origin/main is at a commit whose version stamp cannot be read, so I cannot"
    echo "          tell which version is currently live or whether anyone looked at it."
    echo "          Refusing rather than skipping — a version nobody can name is not a version"
    echo "          anybody looked at."
    echo "          (deliberate exception: git push --no-verify)"
    exit 1
  fi
  if [ -n "$_prev_ver" ] && [ "$_prev_ver" != "$_this_ver" ]; then
    if ! gate_run "second-eye" "python3 tv/second_eye_ledger.py --check $_prev_ver --gate" 30 -- \
         python3 "$REPO/tv/second_eye_ledger.py" --check "$_prev_ver" --gate; then
      echo "pre-push: [$(_pp_el)] ❌ $_this_ver may not ship while $_prev_ver has never been looked at by a"
      echo "          different model family. Render it, hand the pixels to Grok COLD (no hint of"
      echo "          what it should show), and record what came back. To see the state:"
      echo "              python3 tv/second_eye_ledger.py --audit"
      echo "          A dead CLI does not count — an unreachable eye is an empty seat, not agreement."
      echo "          (deliberate exception: git push --no-verify)"
      exit 1
    fi
    echo "pre-push: [$(_pp_el)] ✅ the second eye looked at $_prev_ver."
  fi
  # ⚠⚠ 2026-09-28 — AN UNBUMPED PUSH OF A SURFACE HE CAN SEE IS REFUSED. The block above asks for the second
  # eye only when the version CHANGES, so a push that never bumps skips the look for ever - and his console keeps
  # showing the old version while new code runs. MEASURED: 27 commits went live after v3520 (bible.html and the
  # console among them) with no stamp and no look; he asked "i see no versions have been shipped". A change to
  # bible.html or tv/control_ui.html must ship as a version (tv/bump_version.py), which then earns its look.
  if [ -n "$_prev_ver" ] && [ "$_prev_ver" = "$_this_ver" ] \
     && [ -n "$_se_remote" ] && [ "$_se_remote" != "0000000000000000000000000000000000000000" ]; then
    _pp_vis="$(git diff --name-only "$_se_remote" "$_se_local" -- bible.html tv/control_ui.html 2>/dev/null | head -3 | tr '\n' ' ')"
    if [ -n "$_pp_vis" ]; then
      echo "pre-push: [$(_pp_el)] ❌ this push changes what he SEES ($_pp_vis) but is still stamped $_this_ver,"
      echo "          the version already live - so his console would not change its number, and the second eye"
      echo "          (asked only when the version changes) would never look. Stamp it first:"
      echo "              python3 tv/bump_version.py vNNNN \"name\" \"note HEART: ...\""
      echo "          (deliberate exception: git push --no-verify)"
      exit 1
    fi
  fi
  # ⚠⚠ v2794 — THE MAP GOES STALE SILENTLY, AND IT DID: measured 2026-09-08, BLUEPRINT.md had not
  # been regenerated since Sep 2 and knew nothing of the river or the printer — `station` 0
  # mentions, `INTAKE` 0, `TOMBSTONE` 0, `printer` 0. Both were built after that date. The file's
  # own header says "GENERATED ... so it cannot go stale"; nothing regenerated it, so it did.
  #
  # ⛔ THIS REFUSES, IT DOES NOT REGENERATE. The gate grades the WORKING TREE — a hook that rewrote
  # BLUEPRINT.md here would dirty the tree it is grading AND leave the stale file inside the commit
  # actually being pushed. Refuse, let a human run the generator, push again. Same shape as the
  # second-eye gate above. [[d2r-push-grades-the-working-tree]]
  # REG-2235 (#120) - THE BLUEPRINT AND HEART GATES STARVE WHEN HE IS GAMING, NOT WHEN THE CODE IS WRONG. Both
  # --check runs REGENERATE their map in memory (blueprint walks the tree AST, heart maps every instrument) and
  # diff it, so wall time tracks CPU contention: MEASURED 2026-10-13 blueprint --check exited 0 in 115s under D2R
  # load (1-min load 17-29) and the fixed 60s bound killed it and reported a BUSY machine as a stale map. Heart is
  # the identical 60s back-to-back sibling, so a blueprint-only fix would still refuse at heart (the push is only
  # unblocked when BOTH get the grace). Same grace the render gate uses (REG-1995): GATE_LOAD_GRACE gives a gate
  # busy AT ITS DEADLINE (1-min load > 5) ONE load-measured extension to base x load/5, capped 2.5x (60s -> up to
  # 150s, covering the measured 115s). QUIET at the deadline is still a kill at 60s - the hang detector is
  # untouched, so this does NOT weaken the gate. No up-front GATE_SCALE: neither gate has render_check internal
  # cost model to scale, and widening the quiet-machine kill is the one thing the deadline grace exists to avoid.
  # Released by the unset after the heart gate below, so no later gate inherits it. [[regression-guard]]
  export GATE_LOAD_GRACE=1
  if ! gate_run "blueprint" "python3 tv/blueprint.py --check" 60 -- \
       python3 "$REPO/tv/blueprint.py" --check; then
    echo "pre-push: [$(_pp_el)] ❌ BLUEPRINT.md no longer matches the code."
    echo "          The map is generated so it cannot go stale — but only if it is regenerated."
    echo "              python3 tv/blueprint.py     (then commit it and push again)"
    echo "          (deliberate exception: git push --no-verify)"
    exit 1
  fi
  echo "pre-push: [$(_pp_el)] ✅ the blueprint matches the code."

  # ⚠⚠ v3206 — THE HEART GETS THE BLUEPRINT'S ENFORCEMENT, because it is the half that drifted.
  # His standing order is JOIN -> GATE -> HEART -> BANK, carved as prose on 2026-09-06 — and on
  # 2026-09-16 I read that scar and skipped HEART on five consecutive ships anyway. Prose lost to
  # momentum. BLUEPRINT.md has never drifted, and the reason is mechanical rather than moral:
  # derived, regenerated at bump, refused here when stale. So the heart map travels the same road.
  # ⚠ IT REFUSES, IT DOES NOT REGENERATE — a hook that rewrote the tree would dirty the very bytes
  # it is grading and leave the stale file in the commit being pushed.
  if ! gate_run "heart" "python3 tv/heart_map.py --check" 60 -- \
       python3 "$REPO/tv/heart_map.py" --check; then
    echo "pre-push: [$(_pp_el)] ❌ the heart map does not match the code, or coverage FELL."
    echo "              python3 tv/heart_map.py     (then commit it and push again)"
    exit 1
  fi
  echo "pre-push: [$(_pp_el)] ✅ the heart map matches the code."
  unset GATE_LOAD_GRACE   # REG-2235 (#120) - release the deadline grace so no later gate inherits it
  # ⚠ KNOWN AND DELIBERATE LIMIT: a batched push crossing several version stamps is judged on the
  # BOUNDARY version only — the one that was actually live and therefore actually lookable. The
  # intermediate stamps never shipped on their own, so nothing ever displayed them to a second eye.
  # Written down rather than left as a silent hole. [[unknown-stays-unknown]]
fi

# ══ #42 P5 — THE RENDER GATE RUNS BEFORE THE PROVING STAGE, BECAUSE IT IS THE ONE THAT REFUSES ══════════════════
# MEASURED 2026-09-29 on the v3523 push: every cheap stage green by 0m09s, the changed laws proved and both python
# suites green, and then the render gate REFUSED at 94m53s (and again at ~98m on the retry) on a shelf proof that
# passed alone minutes later. Twice, the whole 83-minute proving stage was paid to learn what a 5-minute render would
# have said first. Across 2026-09-26..28 the render gate refused 3 of 9 pushes, the console demos 1, a blind proof 1 -
# render is the stage most likely to refuse, so it runs right after the cheap stages, before anything long.
# ⚠ THIS IS A MOVE, NOT A CHANGE. The block below is the v2297 render gate byte for byte - its trigger, its port, its
# temporary profile, its 353 s bound, crest-loudness, the kill-by-pid - and every stage it used to follow still runs
# after it. Nothing was removed and no bound moved. It also LEAVES the `tv/ python touched` lane it sat inside
# (textually, since v2297): there, a push that changed only tv/render_coverage.json or art/ - no tv/*.py - never
# rendered at all, while its own v2710 comment says the ratchet file is a change to the verdict. At top level the
# trigger alone decides. The law: test_the_render_gate_runs_before_the_proving_stage.
# ── v2297 — A PIXEL GATE, BECAUSE NOTHING HERE COULD SEE THE PAGE ────────────────────────────
# MEASURED from this very file: the gates that block a push are version-stamp, second-eye,
# review-lite, visual-lock, boss-portraits, test_agent, test_control, test_tz_art,
# test_chronicle_retro, test_chronicle_seal, console-demos and smoke. NOT ONE of them looks at a
# rendered pixel — `visual-lock` is visual_lock_invariant.py, a type-system invariant over tokens.
# render_check.py and run_gates.py ran only locally and in CI.
#
# That is exactly how v2294 got found. The install crest was the single most saturated element
# above the fold — 92.5% of its own pixels, ahead of the help button at 75.7% — on every render for
# many versions, and it took a cross-family read to notice. A parser cannot see "this is the
# loudest thing on the page".
#
# Cost is paid only when something VISUAL is actually shipping, using the same range logic the
# console-demos gate already uses. Both checks exit 2 (UNKNOWN) with no Chrome; UNKNOWN is reported
# as a refusal to certify, never as a pass. [[unknown-stays-unknown]]
_px_touched=0
_px_range=""
if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  _px_range="$(git rev-parse --abbrev-ref '@{u}')..HEAD"
elif git rev-parse --verify origin/main >/dev/null 2>&1; then
  _px_range="origin/main..HEAD"
fi
# ⚠⚠ v2710 — THE GATE'S OWN DEFINITION COUNTS AS A CHANGE TO WHAT IT MEASURES.
# This matched bible.html and control_ui.html only, which is right for "did the PAGE change" and
# wrong for "could the VERDICT change". render_check.py holds the targets, the selectors and the
# declared floors; render_coverage.json holds the ratchet. Widening a selector changes what is
# counted and which floors apply without touching one byte of the page.
# MEASURED: commit 2879656a added `.hrt-svgwrap` to the heart-fan selector, touched no page file,
# and the pre-push log contains ZERO mentions of "render" — the gate never ran. That widened the
# clip scan from 1613 to 1853 nodes and surfaced a second clipped label at 375 against a declared
# floor of 1. heart-fan was RED in the working tree and the push went through clean.
# The one change guaranteed to move the verdict was the one change that did not re-run it.
# ⚠ REG-1753 (#160) — A VERSION STAMP IS NOT A PAGE CHANGE. Every bump rewrites ONE line of bible.html
# (window.D2R_BUILD), so keying this on the file NAME re-rendered the whole page for every console-only ship:
# 46 of the last 80 bible.html commits changed nothing else, and render was 3-5 min of an 8-11 min gate.
# tv/page_delta.py answers "changed beyond its stamp?" and FAILS CLOSED (anything it cannot read = changed).
# The other three files still trigger on their name: any change to them can move the verdict.
_px_watch='^(tv/control_ui\.html|tv/render_check\.py|tv/render_coverage\.json)$'
if git diff --cached --name-only 2>/dev/null | grep -qE "$_px_watch" || python3 "$REPO/tv/page_delta.py" --cached; then
  _px_touched=1
elif [ -n "$_px_range" ] && { git diff --name-only "$_px_range" 2>/dev/null | grep -qE "$_px_watch" || python3 "$REPO/tv/page_delta.py" --range "$_px_range"; }; then
  _px_touched=1
fi
if [ "$_px_touched" = "1" ]; then
  # ⚠ 9222 is his Chrome and 9223 is TradingView. Scratch browsers live on 9224+, need their own
  # --user-data-dir, and need --remote-allow-origins or the WebSocket upgrade is refused 403.
  # ⚠ ONE about:blank, never two. "--headless=new ... about:blank about:blank" is REFUSED with
  # "Multiple targets are not supported in headless mode" and the browser never starts at all —
  # which then reads downstream as "no Chrome", i.e. the launch flag masquerading as a missing
  # browser. Chrome is started fresh for this gate rather than kept warm, because a probe that
  # opens and closes a tab can take an idle headless browser down with it.
  _px_started=0
  # ⚠⚠ A TEMPORARY PROFILE, LIKE render_check's OWN. This launched Chrome against a PERSISTENT
  # profile at tv/.render_shots/chrome-profile — and render_check.py:1751 already mkdtemp's its own
  # precisely because a persistent one "reached 1.4 GB and ENOSPC'd his Mac". That fix could never
  # run on a push: _chrome_up() returns True the moment 9224 answers, and this block has already
  # started Chrome before render_check is invoked. So the scar was recorded, the fix was written,
  # and the gate kept using the thing the fix exists to avoid.
  # MEASURED 2026-09-12: the profile is 1.7 GB — Default/Cache 1.2 GB, Local Storage 231 MB —
  # against 443 PNGs / 147 MB of actual output, 11x its own artifacts, and up 15% in 9 days.
  # ⚠ AND IT WAS COSTING PUSHES, NOT JUST DISK. heart-fan refused with "the panel could not be
  # ACTIVATED after 12.2s" under this profile while the SAME TREE rendered all 18 targets green in
  # 264s standalone, where render_check uses its own mkdtemp. Same code, different profile,
  # opposite verdict. [[ab-against-head-before-blaming-the-room]]
  # ⚠ SWEEP WHAT EARLIER RUNS LEFT. The persistent profile this replaced reached 1.7 GB precisely
  # because nothing ever removed it; a temporary one that leaks on a race is the same disease with
  # a slower clock. Bounded to this exact prefix, and only dirs older than a day so a CONCURRENT
  # push's profile is never taken out from under it.
  find "${TMPDIR:-/tmp}" -maxdepth 1 -type d -name 'd2r-render-profile*' -mtime +0 \
       -exec rm -rf {} + >/dev/null 2>&1 || true
  # v3766 — GNU mktemp refuses `mktemp -d -t d2r-render-profile` (the template has no X).
  # A path ending in XXXXXX is accepted by GNU and by macOS.
  _px_profile="$(mktemp -d "${TMPDIR:-/tmp}/d2r-render-profile.XXXXXX")"
  # ⟦RENDER BROWSER BEGIN⟧
  _d2r_find_render_browser() {
    if [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
      printf '%s\n' "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      return 0
    fi
    local _c _hit _root _glob
    for _c in google-chrome google-chrome-stable chromium chromium-browser; do
      _hit="$(command -v "$_c" 2>/dev/null || true)"
      if [ -n "${_hit:-}" ] && [ -x "$_hit" ]; then
        printf '%s\n' "$_hit"
        return 0
      fi
    done
    local _roots=("${HOME:-/tmp}/.cache/ms-playwright" "${REPO:-.}/node_modules/playwright" "${REPO:-.}/node_modules/playwright-core")
    for _root in "${_roots[@]}"; do
      [ -d "$_root" ] || continue
      for _glob in "$_root"/chromium-*/chrome-linux/chrome "$_root"/.local-browsers/chromium-*/chrome-linux/chrome; do
        if [ -x "$_glob" ]; then
          printf '%s\n' "$_glob"
          return 0
        fi
      done
    done
    return 1
  }
  # ⟦RENDER BROWSER END⟧
  _px_chrome="$(_d2r_find_render_browser 2>/dev/null || true)"
  if ! curl -s -m 2 -o /dev/null "http://127.0.0.1:$TV_RENDER_PORT/json/version"; then
    if [ -n "${_px_chrome:-}" ]; then
    "$_px_chrome" \
      --headless=new --remote-debugging-port="$TV_RENDER_PORT" \
      --user-data-dir="$_px_profile" \
      --no-first-run --no-default-browser-check --disable-gpu \
      --window-size=1440,1000 --remote-allow-origins='*' about:blank \
      >/dev/null 2>&1 &
    _px_chrome_pid=$!
    _px_started=1
    for _i in $(seq 1 25); do
      sleep 1
      curl -s -m 2 -o /dev/null "http://127.0.0.1:$TV_RENDER_PORT/json/version" && break
    done
    fi
  fi
  if curl -s -m 2 -o /dev/null "http://127.0.0.1:$TV_RENDER_PORT/json/version"; then
    # ⚠ 2026-09-27 — 300 -> 353, MEASURED, NOT WISHED: a clean full pass costs 296-317s at his daytime load (~5,
    # reported IDLE by the hang message), so 300 killed runs that had finished all but the last target and called
    # them HUNG. The margins are the old ones moved with the cost (264/280/300 -> 317/333/353: a 16s read floor,
    # 20s to print and tear down). Moves with render_check._CLEAN_RUN_COST / _RUN_REPORT_BY, never alone.
    # REG-1993 - his "raise the limit why not?" (2026-10-07, after this gate starved at 353s, load 8, while he played
    # ON AIR). Not a fixed higher ceiling - that is an absent hang detector on every quiet push: the load measured NOW
    # scales the hook's kill AND render_check's cost and report-by deadline together (tv/render_bound.py, x1-x2.5).
    _rb="$(python3 "$REPO/tv/render_bound.py" 2>/dev/null)"; read -r _rs _rload <<< "${_rb:-1.00 unknown}"
    if [ "${_rs:-1.00}" != "1.00" ]; then
      echo "pre-push: [$(_pp_el)] render bound x${_rs} for load ${_rload} - the hook kill, the clean-run cost and the report-by deadline move together (REG-1993)"
    fi
    export GATE_SCALE="${_rs:-1.00}" TV_RENDER_SCALE="${_rs:-1.00}" GATE_LOAD_GRACE=1
    gate_run "render" "python3 tv/render_check.py" 353 -- python3 "$REPO/tv/render_check.py" || _px_fail=1
    unset GATE_SCALE TV_RENDER_SCALE GATE_LOAD_GRACE
    gate_run "crest-loudness" "python3 tv/crest_loudness.py" 180 -- python3 "$REPO/tv/crest_loudness.py" || _px_fail=1
  else
    echo "pre-push: [$(_pp_el)] 🔴 a visual file is shipping and NO browser could be started — this push was"
    echo "          never looked at. That is UNKNOWN, not a pass."
    _px_fail=1
  fi
  # kill by PID, never by name: :17772 is his live console and pkill -f cannot tell it from ours
  if [ "$_px_started" = "1" ] && [ -n "${_px_chrome_pid:-}" ]; then
    kill "$_px_chrome_pid" >/dev/null 2>&1 || true
    # ⚠⚠ WAIT FOR IT TO ACTUALLY DIE BEFORE REMOVING ITS PROFILE. The first cut removed the dir
    # on the line after `kill`, and Chrome is still shutting down then: the rm took what it could
    # and Chrome RE-CREATED files on its way out, leaving an 8 KB skeleton behind. Measured twice,
    # two pushes apart — 8.0 KB each, with no open handles by the time anyone looked, which is
    # exactly what a race leaves and nothing like a permission failure.
    # Bounded, and on the PID rather than a name: a pattern matches this shell's own siblings.
    # [[wait-on-a-pid-not-a-pattern]]
    _px_w=0
    while kill -0 "$_px_chrome_pid" >/dev/null 2>&1 && [ "$_px_w" -lt 50 ]; do
      sleep 0.1
      _px_w=$((_px_w + 1))
    done
  fi
  # the temp profile goes with it — that is the whole point of it being temporary. Guarded on the
  # prefix so a mistyped variable can never hand `rm -rf` something else.
  case "${_px_profile:-}" in
    */d2r-render-profile*) rm -rf "$_px_profile" >/dev/null 2>&1 || true ;;
  esac
  if [ "${_px_fail:-0}" = "1" ]; then
    echo "pre-push: [$(_pp_el)] BLOCKED — the rendered page did not pass. LOOK AT THE PNGs in tv/.render_shots."
    exit 1
  fi
  echo "pre-push: [$(_pp_el)] ✅ the page was rendered and looked at."
fi

# ══ #42 P5 (second eye) — THE CONSOLE DEMOS RUN RIGHT AFTER THE RENDER GATE, BEFORE THE PROVING STAGE ═════════════
# MEASURED 2026-09-29 on the v3523 push (#3): render ✅ at 112m47s, console-demos ❌ at 113m13s - a 25-second stage
# (DEMOS 15/16, j7_shelfStory, on a :17772 console the hook itself said was running code OLDER than control_app.py)
# paid for behind 96 minutes of proofs. It refused 2 of 13 pushes over 2026-09-27..29 (3519 #3 at 16m42s, v3523 #3);
# the render gate refused 4. The argument that moved the render gate moves this one: the stages likeliest to refuse
# run first, so a refusal costs minutes, not the whole gate.
# ⚠ A MOVE, NOT A CHANGE, except REG-2275. The trigger, the freshness question and the loud
# file-unchanged skip stay. The silent branch no longer starts a console on :17772 and no
# longer kills a pid. Both console-demos call sites stay, bound 180. The indentation stays,
# because the python3 -c program embedded in the freshness question depends on its column-0
# lines. ⚠ AND THE SAME HOLE CLOSED: it sat inside the `tv/ python touched`
# lane, so a push changing only tv/control_ui.html or tv/demo_console.mjs - the very files its trigger names - never
# ran the demos at all. At top level the trigger alone decides. Law: test_the_render_gate_runs_before_the_proving_stage.
  # v938.6 — console DEMO gate: when the console UI changed and the app is UP, the
  # demonstration journeys must pass. App down → skip with a note (never block on an environment
  # the push didn't break). Konyo's "full test system" law.
  #
  # ⚠ v1930 — A SKIP THAT WHISPERS IS A GATE THAT ISN'T THERE. This fires only on a
  # tv/control_ui.html diff with the app up. v1930 was the first push in a while to satisfy both,
  # and it caught J9 failing — which bisection then showed had ALSO been failing on v1924, v1925,
  # v1926, v1927, v1928 and v1929, every one of which pushed clean because none touched that file.
  # Seven versions, a real red gate, and nothing said a word.
  #
  # The trigger is deliberately narrow and stays narrow: widening it would block pushes on an
  # environment the push did not break, which is the thing v938.6 was careful about. What changes
  # is that a SKIP is now LOUD and says WHY and HOW LONG it has been skipping, because "we chose
  # not to run this" and "this passed" must never look the same.
  # [[feedback-blind-fixture-green-gate]]
  _demo_touched=0
  # v2120 — LOOK AT THE WHOLE PUSH, NOT THE LAST COMMIT. This asked `git log -1`, so a push
  # carrying a UI commit FOLLOWED by a test-only commit reported "tv/control_ui.html is unchanged"
  # and skipped — which is exactly what happened on the v2120 push: the UI changed in that push and
  # the gate said it had not. The range is what is actually being shipped.


  _range=""
  if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    _range="$(git rev-parse --abbrev-ref '@{u}')..HEAD"
  elif git rev-parse --verify origin/main >/dev/null 2>&1; then
    _range="origin/main..HEAD"
  fi
  # ⚠⚠ 2026-09-16 — THE DEMOS WATCHED THE PAGE AND NOT THE SERVER, AND SAT OUT 12 COMMITS.
  # This fired only on `tv/control_ui.html`. But `demo_console.mjs` drives the console SERVED BY
  # control_app.py, and its demos press API doors — so a change to the server can break every demo
  # while the page is untouched. MEASURED on this very push: "console demos not run —
  # tv/control_ui.html is unchanged (12 commit(s) since it last was)", across an arc that rewrote
  # chronicle_apply, board_tick, board_mask, the restore doors, and added three new routes.
  # A skip is not a pass, and this one had been skipping since the arc began.
  # ⚠ THIS IS THE SAME HOLE THE RENDER GATE ALREADY HAD — it watched bible.html and control_ui.html
  # and not `render_check.py`, its own definition, until that was widened. One class, two gates.
  # [[regression-guard]] [[gate-moves-with-product]]
  _demo_watch='tv/control_ui\.html|tv/control_app\.py|tv/demo_console\.mjs'
  if git diff --cached --name-only 2>/dev/null | grep -qE "$_demo_watch"; then
    _demo_touched=1
  elif [ -n "$_range" ] && git diff --name-only "$_range" 2>/dev/null | grep -qE "$_demo_watch"; then
    _demo_touched=1
  elif [ -z "$_range" ] && git log -1 --name-only --pretty=format: 2>/dev/null | grep -qE "$_demo_watch"; then
    _demo_touched=1
  fi
  if [ "$_demo_touched" = "1" ]; then
    # #42c — LET HIS CONSOLE FINISH MOVING ONTO THE PUSHED CODE FIRST. v3526 push #1 was REFUSED: the fast-forward put
    # new code on disk, the console's drift lane re-exec'd onto it, and the demos ran 7 s later against a console still
    # booting (16/16 once settled). Bounded at 360 s, and it never refuses a push by itself - the demos decide.
    if curl -s -m 2 -o /dev/null http://127.0.0.1:17772/api/status; then
      echo "pre-push: [$(_pp_el)] $(python3 "$REPO/tv/console_settle.py" --wait 360 --min-age 30 2>/dev/null || echo 'console settle: UNKNOWN - the helper did not run')"
    fi
    # REG-2275 — the freshness question below still ASKS his console, a GET only.
    # It does not start a console and it does not send the demos there. The demo file boots
    # a private control_app. The case-arm text stays so its law can still go red.
    # ⚠⚠ ASK THE CONSOLE, DO NOT TIME ITS PID. This compared the LISTENER PROCESS START to
    # tv/control_app.py's mtime and warned whenever the file was newer — and it was WRONG, on
    # every push, for weeks. MEASURED 2026-09-19 on his live console: the process started
    # Fri Sep 18 23:37:38 and control_app.py was written 17 HOURS LATER, so the heuristic warned;
    # /api/status answered `moduleFreshness {known: true, stale: false, loadedAtMs > srcWrittenMs,
    # say: "this server is the file on disk"}`. A process can re-exec, a supervisor can reload,
    # and a module can be imported long after boot — v3288 built `module_freshness()` precisely
    # because the PID heuristic "can be fooled by a supervisor or a re-exec", said so in its own
    # docstring, and this hook went on using the heuristic anyway. The first-hand answer has
    # existed since v3288 and nothing asked for it. [[the-unjoined-end]] [[stale-reading]]
    #
    # ⚠ AND A THIRD STATE, NOT TWO. Unreachable console, or `known: false`, is UNKNOWN — it must
    # not print a warning, because a warning that fires when nothing was measured is the noise
    # this block has been making. [[unknown-stays-unknown]]
    _fresh="$(curl -s -m 5 http://127.0.0.1:17772/api/status 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    print("unknown|the console did not answer /api/status"); raise SystemExit
f = (d or {}).get("moduleFreshness") or {}
if not f.get("known"):
    print("unknown|" + str(f.get("say") or "the console could not measure its own freshness"))
elif f.get("stale"):
    print("stale|" + str(f.get("say") or "this server is NOT the file on disk"))
else:
    print("fresh|" + str(f.get("say") or "this server is the file on disk"))
' 2>/dev/null || echo "unknown|could not ask the console")"
    case "$_fresh" in
      stale\|*)
        echo "pre-push: [$(_pp_el)] ⚠ the console on :17772 is running code OLDER than tv/control_app.py."
        echo "          It says so itself: ${_fresh#stale|}"
        echo "          The demos below are testing the SERVER AS IT WAS. Page changes are still"
        echo "          seen (control_ui.html is read per request); server changes are NOT."
        echo "          Restart it with 'bash tv/tvd-scan.sh' to make this gate mean what it says."
        ;;
      unknown\|*)
        echo "pre-push: [$(_pp_el)] ⚠ whether the console on :17772 runs the current server is UNKNOWN"
        echo "          (${_fresh#unknown|}). That is not a pass and not a failure — the demos"
        echo "          below are ungraded on server-side changes."
        ;;
    esac
    # REG-2275 (#18 / #73, his 2026-10-13 private yea). The demo boots its own private
    # control_app. This hook does not start one, and it does not point the demo at :17772.
    # j3 used to click the on button on his live console. That click now lands on the
    # private page. A leaked pid file from an older hook is left alone: hunting it would
    # kill a background console that might be his supervisor.
    # REG-2278 — pre-push always owns the console it drives. demoTarget adopts
    # TV_DEMO_PORT when that port is not 17771 or 17772, so an ambient value would
    # drive a listener this hook did not spawn. Both launches below inherit the
    # cleared port and the owned flag.
    unset TV_DEMO_PORT
    export TV_DEMO_OWNED=1
    if curl -s -m 2 -o /dev/null http://127.0.0.1:17772/api/status; then
      echo "pre-push: [$(_pp_el)] his console is up on :17772 — left alone. The demos boot a private console."
      if gate_run "console-demos" "node tv/demo_console.mjs" 180 -- node "$REPO/tv/demo_console.mjs"; then
        echo "pre-push: [$(_pp_el)] ✅ console demos green."
      else
        exit 1
      fi
    else
      echo "pre-push: [$(_pp_el)] :17772 is silent — the demos boot a private console. His port is not bound."
      if gate_run "console-demos" "node tv/demo_console.mjs" 180 -- node "$REPO/tv/demo_console.mjs"; then
        echo "pre-push: [$(_pp_el)] ✅ console demos green (private console, his port untouched)."
        _demo_rc=0
      else
        _demo_rc=1
      fi
      [ "$_demo_rc" = "0" ] || exit 1
    fi
  else
    # How many pushes have gone by without this gate running? Cheap, and it turns an invisible
    # skip into a number he can watch grow.
    _since=$(git log --format=%H -30 2>/dev/null | while read -r _c; do
               if git show --name-only --pretty=format: "$_c" 2>/dev/null | grep -q "tv/control_ui.html"; then break; fi
               echo x
             done | wc -l | tr -d ' ')
    echo "pre-push: [$(_pp_el)] ⏭  console demos not run — tv/control_ui.html is unchanged (${_since} commit(s) since it last was)."
  fi


# ══ REG-2361 — FAIL FAST: EVERY STAGE THAT CAN REFUSE IN MINUTES RUNS BEFORE THE PROVING STAGE ═══════════════════
# MEASURED on the v3783 series (2026-10-21): push 10 proved for 65.7 min, then the sharded test_control suite (126.9 s)
# refused it at 72m37s on a duplicate REG number; push 11 was refused by the same suite at 10m28s. Two of six attempts
# paid the whole proving stage to learn what a two-minute suite already knew. The argument that moved the render gate
# (#42 P5) moves these too: the red-proof anchors, review-lite, visual-lock, the boss portraits and the tv suites with
# their carry now run right after the console demos, and the changed laws are proved LAST. ⚠ A MOVE, NOT A CHANGE:
# each block below is byte for byte what it was - its trigger, its bound, its verdict and its `exit 1` - and the
# proving stage keeps its own. Law: test_the_render_gate_runs_before_the_proving_stage (the order case).

# ══ v3469 — EVERY PUSH CHECKS EVERY RED-PROOF ANCHOR, NOT ONLY THE CHANGED LAWS' ════════════════
# The changed-law block below re-proves a law only when its TEST file is in the push. A proof lives in one test
# file and anchors on a line in ANOTHER, so an ordinary edit to that line never names the proof —
# and it silently changes nothing while the law reads as proven. FOUR on 2026-09-24 (v3455, v3456,
# v3462, v3464 — REG-1163). The census case knew every one; it never ran here. ~5s.
# ⚠ Its reach: an anchor that matches NOTHING (INVALID). A proof that still matches and no longer
# turns red (BLIND) needs a full `heart2 --prove`. ⚠ TOP LEVEL ON PURPOSE — inside the changed-
# tests block it would skip exactly the pushes that edit only the code a proof pins.
if ! gate_run "red-proof anchors" "python3 tv/test_the_heart_can_see_its_own_instruments.py TestHeartSeesItsInstruments.test_every_declared_red_proof_is_well_formed" 120 -- \
     python3 "$REPO/tv/test_the_heart_can_see_its_own_instruments.py" TestHeartSeesItsInstruments.test_every_declared_red_proof_is_well_formed; then
  echo "          ↑ a red-proof's anchor no longer matches the file it tampers — usually an ordinary"
  echo "            edit to a line ANOTHER gate's proof pins (REG-1163). Re-anchor it to the SAME"
  echo "            property; never delete the proof to get green."
  exit 1
fi
echo "pre-push: [$(_pp_el)] ✅ every declared red-proof still matches its anchor."

if ! gate_run "review-lite" "python3 tv/review_lite.py" 120 -- python3 "$REPO/tv/review_lite.py"; then
  echo "          ↑ a live-state path, tolerance, cap or reader guard drifted from what the code"
  echo "            actually does. Fix it, or say why it is now correct, then push again."
  exit 1
fi

if ! gate_run "visual-lock" "python3 visual_lock_invariant.py   (see LOCKED_TYPE_SYSTEM.md)" 120 -- \
     python3 "$REPO/visual_lock_invariant.py"; then
  echo "          ↑ a raw font-weight/spacing literal crept in (or a token went missing)."
  exit 1
fi
echo "pre-push: [$(_pp_el)] ✅ visual-lock intact."

# v1643 — BOSS-PORTRAIT gate (instant, pure stdlib): the twelve boss thumbnails must still be the
# BYTES A HUMAN OPENED (art/boss_portraits.manifest.json pins each sha256 next to a sentence saying
# what that human saw), and bible.html's BOSS_PORTRAIT map must serve exactly those files. Mephisto
# shipped as a blue soulstone and Diablo as a leather book for seven weeks (v269 → v1636) with every
# automated check green — the path resolved, naturalWidth was > 0 — so this gate exists because "it
# loads" was never evidence that it is the right picture.
