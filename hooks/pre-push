# It is here because REG-130: the script had ZERO callers. It passed its own tests and guarded
# nothing. A checker nobody has watched fail from its wired path is not known to be a gate.
if ! gate_run "boss-portraits" "python3 art/verify_boss_portraits.py   (--list to see what each depicts)" 120 -- \
     python3 "$REPO/art/verify_boss_portraits.py"; then
  echo "          ↑ a boss thumbnail is not the picture a human blessed, or bible.html and the"
