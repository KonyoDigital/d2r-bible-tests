#!/usr/bin/env bash
# pre-push — fast critical-path Playwright smoke before a push is allowed, then
# (on a green push to main) AUTO-DEPLOY the site live to Cloudflare Pages.
#
# This hook is VERSION-CONTROLLED (repo-root hooks/) and activated via
# `core.hooksPath = hooks`. On a fresh clone run `bash hooks/install` once to
# enable it (git config is per-clone and cannot travel in the repo itself).
#
# Why the smoke gate: commits sometimes land on main without the suite being run
# (see REG-001 in BUGS.md — a central artOr() edit load-stormed the calc grid and
# broke 3 specs, only caught by CI after the fact). This gate runs a ~1-2 min
# subset covering the three central helpers (artOr / openDrop / switchTab) + the
# lazy-load invariant, so that class of breakage is caught BEFORE the remote.
#
# Why the auto-deploy: deploys are Mac-only and were a manual step. After the smoke
# gate passes, a push to main that touches bible.html / art / functions publishes
# live via deploy.sh. Ordering note: this runs in pre-push (just before the ref
# reaches the remote), so "live" is the exact state being pushed; if the network
# push were to fail afterward, the next push simply re-deploys the merged state.
# Deploy failure WARNS but never blocks the push — the remote is the source of
# truth for code; going live is a convenience on top.
#
# Scope: smoke only runs when the push touches bible.html or a *.spec.ts; deploy
# only runs for refs/heads/main touching bible.html / art / functions /
# tv/install-tvd.ps1 / deploy.sh. Docs-only pushes skip both.
#
# Emergency bypass (use sparingly):  git push --no-verify
set -u

REPO="$(git rev-parse --show-toplevel)" || exit 1

# v1359 — VISUAL-LOCK gate (instant, pure stdlib, no deps): the tokenized type system
# (font-weights + structure/spacing/line-height on bible.html + tv/control_ui.html) must
# never regress to a raw literal instead of a var(--fw/--hd/--ls/--lh) token. Runs on every
# push; catches drift BEFORE the remote. See LOCKED_TYPE_SYSTEM.md.  (bypass: git push --no-verify)
if ! python3 "$REPO/visual_lock_invariant.py" >/dev/null 2>&1; then
  echo "pre-push: ❌ VISUAL-LOCK DRIFT — a raw font-weight/spacing literal crept in (or a token went missing)."
  echo "          Run: python3 visual_lock_invariant.py   (see LOCKED_TYPE_SYSTEM.md)"
  exit 1
fi
echo "pre-push: ✅ visual-lock intact."

# v877 — TV FAST LANE: any tv/*.py in the push runs both python suites (~10s, no Playwright,
# no Chromium, no Mac load). The physically unskippable gate KONYO_WORKFLOW step 12 asks for.
if git diff --name-only @{push}.. 2>/dev/null | grep -qE '^tv/.*\.py$'; then
  echo "pre-push: tv/ python touched — running the agent+control suites…"
  if ! python3 "$REPO/tv/test_agent.py" >/dev/null 2>&1; then
    echo "pre-push: ❌ tv/test_agent.py FAILED — push blocked. Run: python3 tv/test_agent.py"
    exit 1
  fi
  if ! python3 "$REPO/tv/test_control.py" >/dev/null 2>&1; then
    echo "pre-push: ❌ tv/test_control.py FAILED — push blocked. Run: python3 tv/test_control.py"
    exit 1
  fi
  echo "pre-push: ✅ tv suites green."
  # v938.6 — console DEMO gate: when the console UI changed and the app is UP, the six
  # demonstration journeys must pass (1.6s). App down → skip with a note (never block on
  # an environment the push didn't break). Konyo's "full test system" law.
  if git diff --cached --name-only 2>/dev/null | grep -q "tv/control_ui.html" ||      git log -1 --name-only --pretty=format: 2>/dev/null | grep -q "tv/control_ui.html"; then
    if curl -s -m 2 -o /dev/null http://127.0.0.1:17772/api/status; then
      if node "$REPO/tv/demo_console.mjs" >/dev/null 2>&1; then
        echo "pre-push: ✅ console demos 6/6."
      else
        echo "pre-push: ❌ console demos FAILED — push blocked. Run: node tv/demo_console.mjs"
        exit 1
      fi
    else
      echo "pre-push: (console app down — demo gate skipped)"
    fi
  fi
fi
cd "$REPO" || exit 1

SMOKE_SPECS=(
  tests/01_smoke.spec.ts
  tests/v71_d2art.spec.ts
  tests/v74_material_search.spec.ts
  tests/v80_endgame_relics.spec.ts
  tests/v535_ux_simulation.spec.ts   # v535 — USER-EXPERIENCE sims: drive the rendered UI (tabs/cards/buttons),
                                     # catch render-vs-logic drift + cross-tab platform sync. Konyo's ask to
                                     # bake UX simulations into the autonomous-loop workflow, not just CI.
  tests/v604_forge_coverage_invariant.spec.ts   # v604 — NO SILENT WORDS: every unmade word tasked in
                                     # forgeScan AND rendered in the Forge DOM + the Katar-scenario UX sim
                                     # (register an exact-fit base -> its word lands ON that base, visibly).
  tests/v616_class_restriction_invariant.spec.ts   # v616 — GAME-RULE LOCK: full-catalog sweep — class-
                                     # gated words (Exile=auric, Pattern/Chaos=claws, circlets host
                                     # nothing) can never leak onto illegal bases; art homes stay legal.
  tests/v630_exclusivity_reservation.spec.ts   # v630 — EXCLUSIVITY RESERVATION: a class-locked word
                                     # (Exile) claims its owned host first; broad words (Phoenix) re-task
                                     # with the earmark narration; readiness order preserved among peers.
  tests/v631_promote_unknown_bases.spec.ts   # v631 — '(Nos)' reads stuck in unknownReads that exact-fit
                                     # an unmade word are PROMOTED to owned forge bases at boot/scan-finish
                                     # (Konyo's Heavy Crossbow → Mist); junk reads stay in the ledger.
  tests/v635_ladder_profile.spec.ts   # v635 — LADDER ACCOUNT bleed-proof invariant: the storage router
                                     # keeps main byte-identical while the ladder profile lives a full
                                     # forge life (make-now → created → consume) under L· keys.
  tests/v636_ladder_closure.spec.ts   # v636 — the closure-swarm locks: profile-scoped wipe, SEEN pre-seed,
                                     # ladder consistency (_rwLadderBlocked/rwVerify/rwSetLadderMode),
                                     # per-profile Backup&Share, and the no-silent sweep INSIDE ladder.
  tests/v637_oneway_inheritance.spec.ts   # v638 — SHARED CHRONICLE: one grail ledger both ways (a forge
                                     # counts from either account); vaults/tallies never cross; the
                                     # v637-era orphaned L· chronicle reconciles once, union-only.
  tests/v644_grail_ledger.spec.ts   # v644 — THE GRAIL LEDGER: every unique/piece one-click tickable,
                                     # dated found-chronicle (d2r_foundLog), undo-last, tallies both ways.
)

ZERO="0000000000000000000000000000000000000000"
run=0       # 1 = run the smoke gate
deploy=0    # 1 = auto-deploy after a green push

# stdin lines (single pass — bash 3.2 has no mapfile): set BOTH run and deploy,
# never break early so every ref is considered.
# Each line: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion — nothing to do

  if [ "$remote_sha" = "$ZERO" ]; then
    changed=""                                     # new remote branch — no base to diff
    new_branch=1
  else
    changed="$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null)"
    new_branch=0
  fi

  # smoke trigger: bible.html or any spec changed (or a brand-new branch)
  if [ "$new_branch" = "1" ] || printf '%s\n' "$changed" | grep -Eq '^(bible\.html|tests/.*\.spec\.ts)$'; then
    run=1
  fi

  # deploy trigger: pushing main, and a deployable asset changed
  # v755.1 — also ship when the cousin installer (or deploy.sh headers) changes
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$new_branch" = "1" ] || printf '%s\n' "$changed" | grep -Eq '^(bible\.html|art/.*|functions/.*|tv/install-tvd\.ps1|tv/install-tvd\.sh|deploy\.sh)$'; then
      deploy=1
    fi
  fi
done

# ── 1. Smoke gate (blocks the push on failure) ───────────────────────────────
if [ "$run" -eq 0 ]; then
  echo "pre-push: no bible.html / spec changes in this push — skipping smoke."
elif ! command -v npx >/dev/null 2>&1; then
  echo "pre-push: WARNING — npx not found on PATH; cannot run the smoke gate."
  echo "          Allowing the push, but please run 'npx playwright test' manually."
else
  echo "pre-push: running critical-path Playwright smoke (~1-2 min)…"
  echo "          (emergency bypass: git push --no-verify)"
  echo ""
  if npx playwright test "${SMOKE_SPECS[@]}" --workers=2 --reporter=line; then
    echo ""
    echo "pre-push: smoke GREEN — push allowed."
  else
    echo ""
    echo "pre-push: smoke FAILED — push BLOCKED."
    echo "          Fix the failing spec(s), then push again. Full suite: npx playwright test"
    echo "          Emergency override (NOT recommended): git push --no-verify"
    exit 1
  fi
fi

# ── 2. Auto-deploy (after green; warns but never blocks) ─────────────────────
if [ "$deploy" -eq 1 ]; then
  echo ""
  echo "pre-push: main + deployable change — publishing live…"
  if bash "$REPO/deploy.sh"; then
    : # deploy.sh prints its own success line
  else
    rc=$?
    if [ "$rc" -eq 2 ]; then
      echo "pre-push: deploy SKIPPED (missing token/npx) — push still allowed; deploy by hand: bash deploy.sh"
    else
      echo "pre-push: deploy FAILED — push still allowed; re-run by hand: bash deploy.sh"
    fi
  fi
fi

exit 0
