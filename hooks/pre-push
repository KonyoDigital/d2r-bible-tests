#!/usr/bin/env bash
# pre-push — fast critical-path Playwright smoke before a push is allowed.
#
# This hook is VERSION-CONTROLLED (repo-root hooks/) and activated via
# `core.hooksPath = hooks`. On a fresh clone run `bash hooks/install` once to
# enable it (git config is per-clone and cannot travel in the repo itself).
#
# Why: commits sometimes land on main without the suite being run (see REG-001 in
# BUGS.md — a central artOr() edit load-stormed the calc grid and broke 3 specs,
# only caught by CI after the fact). This gate runs a ~1-2 min subset that covers
# the three central helpers (artOr / openDrop / switchTab) + the lazy-load
# invariant, so that class of breakage is caught BEFORE it reaches the remote.
#
# Scope: only runs when the push touches bible.html or a *.spec.ts (docs-only
# pushes skip straight through).
#
# Emergency bypass (use sparingly):  git push --no-verify
set -u

REPO="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO" || exit 1

SMOKE_SPECS=(
  tests/01_smoke.spec.ts
  tests/v71_d2art.spec.ts
  tests/v74_material_search.spec.ts
  tests/v80_endgame_relics.spec.ts
)

ZERO="0000000000000000000000000000000000000000"
run=0

# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion — nothing to test
  if [ "$remote_sha" = "$ZERO" ]; then
    run=1; break                                   # new remote branch — test to be safe
  fi
  changed="$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null)"
  if printf '%s\n' "$changed" | grep -Eq '^(bible\.html|tests/.*\.spec\.ts)$'; then
    run=1; break
  fi
done

if [ "$run" -eq 0 ]; then
  echo "pre-push: no bible.html / spec changes in this push — skipping smoke."
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "pre-push: WARNING — npx not found on PATH; cannot run the smoke gate."
  echo "          Allowing the push, but please run 'npx playwright test' manually."
  exit 0
fi

echo "pre-push: running critical-path Playwright smoke (~1-2 min)…"
echo "          (emergency bypass: git push --no-verify)"
echo ""
if npx playwright test "${SMOKE_SPECS[@]}" --workers=2 --reporter=line; then
  echo ""
  echo "pre-push: smoke GREEN — push allowed."
  exit 0
fi

echo ""
echo "pre-push: smoke FAILED — push BLOCKED."
echo "          Fix the failing spec(s), then push again. Full suite: npx playwright test"
echo "          Emergency override (NOT recommended): git push --no-verify"
exit 1
