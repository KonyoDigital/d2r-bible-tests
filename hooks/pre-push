# v3768 — a stored PASS carries when its commit is an ancestor of HEAD and git says none of
# its inputs moved. A miss, a missing ledger and a corrupt ledger all fall through and the gate runs.
# FAIL is never stored. --record stores a PASS only when suite_verdict already proved these bytes,
# and (REG-2293 r5) only with a trace of what the run read. REG-2293 r6: a suite this hook runs
# fresh runs traced (`gate_ledger.py --trace-env`) and is recorded with `--trace`; a reused verdict
# had no run here, so it has no trace and stores nothing (it prints why).
ledger_carry() {
  python3 "$REPO/tv/gate_ledger.py" --carry "$1"
}

# v877 — TV FAST LANE: any tv/*.py in the push runs both python suites (~10s, no Playwright,
# no Chromium, no Mac load). The physically unskippable gate KONYO_WORKFLOW step 12 asks for.
# REG-2395 - AND IT IS NEVER SKIPPED ON AN UNKNOWN, NOR IN SILENCE. Its trigger was `git diff --name-only @{push}..`
# alone: where @{push} did not resolve the diff failed, grep matched nothing, and every suite in this lane was skipped
# with no line (the changed-law block below already fell back and said so; this lane did neither). It reads the range
# the push-range block resolved at the top (@{push}, else origin/main..HEAD). A range that cannot be read RUNS the
# lane, and every outcome names the range it read. Law: test_a_leaked_git_dir_never_writes_the_real_repo.
# >>> tv-lane
_tv_lane=""
if [ -z "${TV_PUSH_BASE:-}" ]; then
  _tv_lane="unknown"
elif _tv_files="$(git diff --name-only "${TV_PUSH_BASE}..HEAD" 2>/dev/null)"; then
  printf '%s\n' "$_tv_files" | grep -qE '^tv/.*\.py$' && _tv_lane="touched"
else
  _tv_lane="unknown"
fi
if [ "$_tv_lane" = "touched" ]; then
  echo "pre-push: [$(_pp_el)] tv/ python touched in ${TV_PUSH_RANGE:-?} — running the agent+control suites…"
elif [ "$_tv_lane" = "unknown" ]; then
  echo "pre-push: [$(_pp_el)] ⚠ what this push changes cannot be read (${TV_PUSH_RANGE:-no range}), so the tv suites"
  echo "          RUN - an UNKNOWN range is never a skip (REG-2395)."
else
  echo "pre-push: [$(_pp_el)] ⏭  no tv/*.py changed in ${TV_PUSH_RANGE:-?} - the tv suites do not run."
fi
# <<< tv-lane
if [ -n "$_tv_lane" ]; then
  # #42 lever 2 (REG-1720) — A GREEN SUITE RUN IS REUSED ONLY ON IDENTICAL BYTES. MEASURED on v3556's push: these two
  # suites were 10m26s of 17m16s, re-running a commit that had already passed them. tv/suite_verdict.py reuses a green
  # run keyed on the commit's git tree (every tracked file unchanged, same python/platform, younger than 6 h) - one made
  # when the commit was (`suite_verdict.py --run`) or by an earlier push of the same bytes; a run of these bytes still in
  # flight is waited for. Anything else runs the suite here, as before. CI still runs both suites in full after the push.
  # SUITE_VERDICT_REUSE=0 git push closes it for one push.
  _carry_line="$(ledger_carry test_agent)"
  _carry_rc=$?
  if [ "$_carry_rc" -eq 0 ]; then
    echo "pre-push: [$(_pp_el)] test_agent carried: $_carry_line"
  else
    echo "pre-push: [$(_pp_el)] $_carry_line"
    if python3 "$REPO/tv/suite_verdict.py" --check test_agent --wait 900; then
      echo "pre-push: [$(_pp_el)] ✅ test_agent: a green run of these exact bytes was reused (the line above names it)."
      python3 "$REPO/tv/gate_ledger.py" --record test_agent || true
    else
      # REG-2293 r6 - the run is traced, so --record can store what it read (a reuse above has no run, so no trace).
      _tr="$(python3 "$REPO/tv/gate_ledger.py" --trace-path)"
      if ! ( eval "$(python3 "$REPO/tv/gate_ledger.py" --trace-env "$_tr")"; gate_run "test_agent" "python3 tv/test_agent.py" 600 -- python3 "$REPO/tv/test_agent.py" ); then
        rm -f "$_tr"
        exit 1
      fi
      python3 "$REPO/tv/suite_verdict.py" --record test_agent || true
      python3 "$REPO/tv/gate_ledger.py" --record test_agent --trace "$_tr" || true
      rm -f "$_tr"
    fi
  fi
  # ⚠ v2361 — 600s ASSUMED AN IDLE MACHINE, AND HIS IS NOT. Measured 2026-08-31 on the same
  # tree: 385s with the Mac quiet, 719s with D2R running at 110% CPU. A ceiling set between
  # those two numbers does not catch a hung suite - it blocks every push he makes while he
  # is playing, which is most of them, and the message says HUNG when nothing hung.
  # 1500s still catches a genuine wedge (the suite has never exceeded 720s) while leaving
  # room for the machine he actually owns. [[feedback-threshold-above-the-ceiling]]
  _carry_line="$(ledger_carry test_control)"
  _carry_rc=$?
  if [ "$_carry_rc" -eq 0 ]; then
    echo "pre-push: [$(_pp_el)] test_control carried: $_carry_line"
  else
    echo "pre-push: [$(_pp_el)] $_carry_line"
    if python3 "$REPO/tv/suite_verdict.py" --check test_control --wait 1500; then
      echo "pre-push: [$(_pp_el)] ✅ test_control: a green run of these exact bytes was reused (the line above names it)."
      python3 "$REPO/tv/gate_ledger.py" --record test_control || true
    else
      # #42 lever 4 (2026-10-02) - AS PARALLEL SHARDS. Measured per class: one case was 271.6 s of 435.6 s (fixed in the
      # suite: 133.6 s); then 4 shards by class ran all 2,259 cases in 66-88 s (3 green runs, his game running beside them).
      # tv/shard_suite.py is green only when every shard ran every case it was dealt and every class was dealt - a shard
      # that dies or runs less is RED. SUITE_SHARDS=1 runs it as one shard. CI still runs the whole file serially.
      _tr="$(python3 "$REPO/tv/gate_ledger.py" --trace-path)"
      if ! ( eval "$(python3 "$REPO/tv/gate_ledger.py" --trace-env "$_tr")"; gate_run "test_control" "python3 tv/shard_suite.py test_control" 1500 -- python3 "$REPO/tv/shard_suite.py" test_control ); then
        rm -f "$_tr"
        exit 1
      fi
      python3 "$REPO/tv/suite_verdict.py" --record test_control || true
      python3 "$REPO/tv/gate_ledger.py" --record test_control --trace "$_tr" || true
      rm -f "$_tr"
    fi
  fi
  # REG-2362 - THE CASES THAT LEFT test_control TO LET IT BE KEYED STILL STOP A PUSH. test_control listed folders at
  # 40 sites, so heart2 could never save one of its proofs; the cases that genuinely read what a folder holds (an
  # unregistered suite, an import CI lacks, a pkill, a paid lane, the art corpus, the footage detectors) moved to
  # tv/test_folder_scans.py, byte for byte. They ran here inside test_control, so they run here still - same lane,
  # same refusal. ~10 s. No --record: like test_tz_art below, run_gates stores what it actually runs.
  _carry_line="$(ledger_carry test_folder_scans)"
  _carry_rc=$?
  if [ "$_carry_rc" -eq 0 ]; then
    echo "pre-push: [$(_pp_el)] test_folder_scans carried: $_carry_line"
  else
    echo "pre-push: [$(_pp_el)] $_carry_line"
    if ! gate_run "test_folder_scans" "python3 tv/test_folder_scans.py" 600 -- python3 "$REPO/tv/test_folder_scans.py"; then
      exit 1
    fi
  fi
  # v1578 — the TZ panel's DATA (67 zones -> game-extracted art + the game's own density/level, and
  # the tiering that greys a zone out). Cheap, pure stdlib, and it guards a surface Konyo looks at
  # every hour: a missing art key is a broken image on his TV that the browser reports to nobody.
  _carry_line="$(ledger_carry test_tz_art)"
  _carry_rc=$?
  if [ "$_carry_rc" -eq 0 ]; then
    echo "pre-push: [$(_pp_el)] test_tz_art carried: $_carry_line"
  else
    echo "pre-push: [$(_pp_el)] $_carry_line"
    if ! gate_run "test_tz_art" "python3 tv/test_tz_art.py" 120 -- python3 "$REPO/tv/test_tz_art.py"; then
      exit 1
    fi
    # No --record here. These three have no suite_verdict, and --record must not mint a PASS
    # the hook merely claims it ran. run_gates stores them after it actually runs them.
  fi
  # 2026-08-20 — THE CHRONICLE GATES RAN ONLY IN CI, AND ONE SAT RED FOR NINE VERSIONS.
  # run_gates.py runs 30 gates; this hook ran three. test_chronicle_seal extracts the seal loop
  # straight out of control_app.py and execs it, so v1830 adding the reader stamp to a seal broke it
  # instantly — and nothing local said a word, because tv-tests.yml is the only thing that runs it.
  # v1830..v1838 all shipped over a red gate nobody was looking at.
  # Both suites are pure stdlib and finish in well under a second together, so the fast lane stays
  # fast. [[feedback-ci-verdict-before-seal]]
  _carry_line="$(ledger_carry test_chronicle_retro)"
  _carry_rc=$?
  if [ "$_carry_rc" -eq 0 ]; then
    echo "pre-push: [$(_pp_el)] test_chronicle_retro carried: $_carry_line"
  else
    echo "pre-push: [$(_pp_el)] $_carry_line"
    if ! gate_run "test_chronicle_retro" "python3 tv/test_chronicle_retro.py" 120 -- \
         python3 "$REPO/tv/test_chronicle_retro.py"; then
      exit 1
    fi
  fi
  _carry_line="$(ledger_carry test_chronicle_seal)"
  _carry_rc=$?
  if [ "$_carry_rc" -eq 0 ]; then
    echo "pre-push: [$(_pp_el)] test_chronicle_seal carried: $_carry_line"
  else
    echo "pre-push: [$(_pp_el)] $_carry_line"
    if ! gate_run "test_chronicle_seal" "python3 tv/test_chronicle_seal.py" 120 -- \
         python3 "$REPO/tv/test_chronicle_seal.py"; then
      exit 1
    fi
  fi
  echo "pre-push: [$(_pp_el)] ✅ tv suites green."
fi

# >>> fast-gate
# v3847 FAST GATE (Elad 2026-10-30 15:29) - THE GATE SET RUNS IN THE HOOK, NOT AS A STEP SOMEONE REMEMBERS. The full
# run_gates.py was a ~65 min manual procedure step; the push now runs `run_gates.py --fast`: the core set
# (tv/fast_core.txt) + every gate whose law names a changed file. bible.html / control_ui.html / control_app.py /
# the gate machinery -> EVERY gate (--full). CI runs every gate sharded after the push and the nightly runs every gate
# on main (tv/nightly_full_gates.sh). Law: test_the_fast_gate_runs_the_core_and_what_changed.
if ! gate_run "fast gate set" "python3 tv/run_gates.py --fast" 5400 -- \
     env TV_FAST_BASE="${TV_PUSH_BASE:-origin/main}" python3 "$REPO/tv/run_gates.py" --fast; then
  echo "          ↑ a gate in the fast set is red - fix it; the push does not go."
  exit 1
fi
echo "pre-push: [$(_pp_el)] ✅ fast gate set green."
# <<< fast-gate

# ══ v3292 — A CHANGED LAW MUST DEMONSTRATE IT CAN STILL GO RED ════════════════════════════════
# A red-proof came back BLIND this session: it matched its anchor exactly once, deleted the clause
# it targeted, and the law stayed GREEN — it had been asserting phrases that occur three times
# elsewhere in the file, so unrelated sites satisfied it and it never pinned its own branch. It was
# caught only because `heart2.py --prove` happened to be run BY HAND. Nothing in this hook ran it.
#
# ⚠ ONLY THE GATES WHOSE TEST FILE IS IN THIS PUSH. Proving all 435 would add minutes to a gate
# that already runs 12-20, and the laws at risk are the ones just written or edited.
#
# ⚠ THE ASYMMETRY IS DELIBERATE: it FAILS OPEN when it cannot work out which gates changed (a skip,
# announced as a skip, never as a pass) and FAILS CLOSED on an actual BLIND or INVALID verdict. A
# hook that blocks his push over its own confusion is one that gets bypassed.
# ⚠ v3293 — FOUR HOLES THE CROSS-FAMILY EYE FOUND IN v3292'S FIRST CUT, all real:
#   · `@{push}` is not always resolvable (detached HEAD, no upstream, odd remote name). The old
#     `2>/dev/null || true` turned that into a SILENT no-check. A skip must announce itself.
#   · a DELETED test file still resolved to a gate name, so removing a test would have blocked the
#     push over a proof for a file that is gone. Only files still on disk are considered.
#   · gate names were interpolated unvalidated. They stay unquoted on purpose — word-splitting is
#     what passes several names as several arguments — so the NAMES are validated instead.
#   · the temp log was never removed.
_chg_tests=""
if git rev-parse --verify --quiet '@{push}' >/dev/null 2>&1; then
  _chg_tests="$(git diff --name-only '@{push}..' 2>/dev/null | grep -E '^tv/test_.*\.py$' || true)"
elif git rev-parse --verify --quiet 'origin/main' >/dev/null 2>&1; then
  _chg_tests="$(git diff --name-only 'origin/main..HEAD' 2>/dev/null | grep -E '^tv/test_.*\.py$' || true)"
else
  echo "pre-push: [$(_pp_el)] ⚠ neither @{push} nor origin/main resolves, so the changed-law set is UNKNOWN"
  echo "          and no red-proof was exercised. THIS IS A SKIP, NOT A PASS."
fi
# a test file deleted in this push has no law left to prove — drop it before deriving gates
_chg_live=""
for _f in $_chg_tests; do
  [ -f "$REPO/$_f" ] && _chg_live="$_chg_live $_f"
done
if [ -n "$_chg_live" ]; then
  _gates="$(python3 - $_chg_live <<'PYGATE' 2>/dev/null || true
import sys, os, re
sys.path.insert(0, "tv")
try:
    import run_gates
except Exception:
    sys.exit(0)
changed = {os.path.basename(p) for p in sys.argv[1:]}
SAFE = re.compile(r"^[A-Za-z0-9_.-]+$")       # a name that is safe to pass as a bare argument
out = []
for g in run_gates.GATES:
    for part in (getattr(g, "argv", None) or []):
        if os.path.basename(str(part)) in changed:
            if SAFE.match(str(g.name or "")):
                out.append(g.name)
            break
print(" ".join(sorted(set(out))))
PYGATE
)"
  # >>> browser split (REG-2963, #161 stage 2) - A BROWSER LAW IS PROVED ON GITHUB WHEN THE DEPLOY WAITS FOR IT THERE.
  # tv/proof_keys_mac.py --split reads the refs being pushed and the two workflow files: a changed law that starts a
  # browser goes to the CI proof job only when this push ships to main AND publish.yml's deploy waits for that job
  # (REG-2962); a law only the Mac can prove, every non-browser law, and every law when either is not so, is proved
  # here. Each changed law lands in exactly one venue, and the ones left to CI are NAMED - never a silent skip. A split
  # that cannot be decided proves every changed law here. Law: test_a_browser_law_is_proved_on_one_venue_at_least.
  _gates_ci=""
  if [ -n "$_gates" ]; then
    _split="$(printf '%s\n' "$_PUSH_REFS" | python3 "$REPO/tv/proof_keys_mac.py" --split $_gates 2>/dev/null)" || _split=""
    if printf '%s\n' "$_split" | grep -q '^local:'; then
      _gates_ci="$(printf '%s\n' "$_split" | sed -n 's/^ci: *//p')"
      _gates="$(printf '%s\n' "$_split" | sed -n 's/^local: *//p')"
      if [ -n "$_gates_ci" ]; then
        echo "pre-push: [$(_pp_el)] the CI proof job proves $(echo $_gates_ci | wc -w | tr -d ' ') browser law(s); the deploy waits for it"
        echo "          ($(printf '%s\n' "$_split" | sed -n 's/^why: *//p')): $_gates_ci"
      fi
    else
      echo "pre-push: [$(_pp_el)] ⚠ the browser split could not be decided - every changed law is proved here"
    fi
  fi
  # <<< browser split
  if [ -z "$_gates" ] && [ -z "$_gates_ci" ]; then
    echo "pre-push: [$(_pp_el)] ⚠ tv/test_*.py changed but no gate name could be derived, so no red-proof was"
    echo "          exercised. THIS IS A SKIP, NOT A PASS."
  elif [ -z "$_gates" ]; then
    echo "pre-push: [$(_pp_el)] every changed law is a browser law the CI proof job proves - nothing to prove here"
  else
    _prove_log="${TMPDIR:-/tmp}/d2r-prove.$$.log"
    # REG-2361 — WHAT THE PROVING STAGE IS ABOUT TO COST, SAID BEFORE IT STARTS. `heart2 --forecast` reads the keys and
    # the red memory and prints, per gate, what will hit, narrow, run in full or cannot be keyed - and runs nothing. It
    # is a preview, never a verdict: bounded at 120 s, and any exit but 0 (a tree whose heart2 predates the flag says
    # "unrecognized arguments" and exits 2) is ONE line and the proving goes on. Nothing in this block may refuse a push.
    # >>> forecast
    _fc_log="${TMPDIR:-/tmp}/d2r-forecast.$$.log"
    perl -e 'my $t = shift; my $p = fork; die "fork: $!" unless defined $p;
             if (!$p) { exec @ARGV; exit 127 }
             $SIG{ALRM} = sub { kill "TERM", $p; waitpid($p, 0); exit 142 };
             alarm $t; my $r; do { $r = waitpid($p, 0) } while ($r == -1 && $!{EINTR}); my $st = $?; alarm 0;
             exit(($st & 127) ? 128 + ($st & 127) : ($st >> 8));' 120 \
         python3 "$REPO/tv/heart2.py" --forecast $_gates </dev/null >"$_fc_log" 2>&1
    _fc_rc=$?
    if [ "$_fc_rc" -eq 0 ]; then
      echo "pre-push: [$(_pp_el)] forecast for the proving stage (tv/heart2.py --forecast):"
      sed 's/^/          /' "$_fc_log"
    else
      echo "pre-push: [$(_pp_el)] ⚠ no forecast (tv/heart2.py --forecast exit ${_fc_rc}: $(tail -1 "$_fc_log" 2>/dev/null | cut -c1-120)) - not a refusal; proving goes on."
    fi
    rm -f "$_fc_log"
    # <<< forecast
    # #42 — --push, and ONLY on this call: a red-proof that declares the widths its defect shows at runs its clean and
    # tampered runs only there (one that declares none runs at every width); the proofs likeliest to fail run first
    # and the run STOPS at the first BLIND / INVALID / clean-run red; a gate that starts a browser is proved one at a
    # time. A declared width that stays green is BLIND and refuses exactly as before. The full sweep stays run_gates'
    # and CI's - neither ever sets TV_LAW_WIDTHS (test_a_push_proof_runs_only_where_its_defect_shows).
    # #151 (his 2026-10-21: "heart2 says '1 lane' at the TOP of the push") - the lane count and its reason, said where
    # the proving stage starts. It was one line inside the prove log, which this hook deletes on success and cuts to its
    # last 24 lines on failure: on 10-21 every push proved one law at a time at 4.0 GB free and nothing on screen said so.
    _lanes_say=$(cd "$REPO/tv" && python3 -c 'import sys
import heart2 as h
said = []
n = h.prove_workers(int(sys.argv[1]), say=said.append)
print("%d lane(s)%s" % (n, (" - " + said[-1].strip()) if said else ""))' "$(echo $_gates | wc -w | tr -d ' ')" 2>/dev/null | tail -1)
    echo "pre-push: [$(_pp_el)] proving $(echo $_gates | wc -w | tr -d ' ') changed law(s) in ${_lanes_say:-UNKNOWN lane(s) - heart2 could not say}"
    if python3 "$REPO/tv/heart2.py" --prove $_gates --push > "$_prove_log" 2>&1; then
      echo "pre-push: [$(_pp_el)] ✅ every changed law demonstrated it can still go red."
      rm -f "$_prove_log"
    else
      echo "pre-push: [$(_pp_el)] ❌ a changed law has a red-proof that PROVES NOTHING — push blocked."
      echo "          Reproduce: python3 tv/heart2.py --prove $_gates"
      echo "          ── last 24 lines ───────────────────────────────────────────"
      tail -24 "$_prove_log" | sed 's/^/          /'
      echo "          ────────────────────────────────────────────────────────────"
      echo "          A law that cannot go red is not a law. BLIND means the sabotage ran and the"
      echo "          law stayed green; INVALID means the anchor matched nothing, so the proof"
      echo "          changed no byte. Both report coverage they do not provide."
      rm -f "$_prove_log"
      exit 1
    fi
  fi
fi
cd "$REPO" || exit 1

SMOKE_SPECS=(
  tests/01_smoke.spec.ts
  tests/v71_d2art.spec.ts
  tests/v74_material_search.spec.ts
  tests/v80_endgame_relics.spec.ts
  tests/v535_ux_simulation.spec.ts   # v535 — USER-EXPERIENCE sims: drive the rendered UI (tabs/cards/buttons),
                                     # catch render-vs-logic drift + cross-tab platform sync. Konyo's ask to
                                     # bake UX simulations into the autonomous-loop workflow, not just CI.
  tests/v604_forge_coverage_invariant.spec.ts   # v604 — NO SILENT WORDS: every unmade word tasked in
                                     # forgeScan AND rendered in the Forge DOM + the Katar-scenario UX sim
                                     # (register an exact-fit base -> its word lands ON that base, visibly).
  tests/v616_class_restriction_invariant.spec.ts   # v616 — GAME-RULE LOCK: full-catalog sweep — class-
                                     # gated words (Exile=auric, Pattern/Chaos=claws, circlets host
                                     # nothing) can never leak onto illegal bases; art homes stay legal.
  tests/v630_exclusivity_reservation.spec.ts   # v630 — EXCLUSIVITY RESERVATION: a class-locked word
                                     # (Exile) claims its owned host first; broad words (Phoenix) re-task
                                     # with the earmark narration; readiness order preserved among peers.
  tests/v631_promote_unknown_bases.spec.ts   # v631 — '(Nos)' reads stuck in unknownReads that exact-fit
                                     # an unmade word are PROMOTED to owned forge bases at boot/scan-finish
                                     # (Konyo's Heavy Crossbow → Mist); junk reads stay in the ledger.
  tests/v635_ladder_profile.spec.ts   # v635 — LADDER ACCOUNT bleed-proof invariant: the storage router
                                     # keeps main byte-identical while the ladder profile lives a full
                                     # forge life (make-now → created → consume) under L· keys.
  tests/v636_ladder_closure.spec.ts   # v636 — the closure-swarm locks: profile-scoped wipe, SEEN pre-seed,
                                     # ladder consistency (_rwLadderBlocked/rwVerify/rwSetLadderMode),
                                     # per-profile Backup&Share, and the no-silent sweep INSIDE ladder.
  tests/v637_oneway_inheritance.spec.ts   # v638 — SHARED CHRONICLE: one grail ledger both ways (a forge
                                     # counts from either account); vaults/tallies never cross; the
                                     # v637-era orphaned L· chronicle reconciles once, union-only.
  tests/v644_grail_ledger.spec.ts   # v644 — THE GRAIL LEDGER: every unique/piece one-click tickable,
                                     # dated found-chronicle (d2r_foundLog), undo-last, tallies both ways.
)

ZERO="0000000000000000000000000000000000000000"
run=0       # 1 = run the smoke gate
deploy=0    # 1 = auto-deploy after a green push

# stdin lines (single pass — bash 3.2 has no mapfile): set BOTH run and deploy,
# never break early so every ref is considered.
# Each line: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion — nothing to do

  if [ "$remote_sha" = "$ZERO" ]; then
    changed=""                                     # new remote branch — no base to diff
    new_branch=1
  else
    changed="$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null)"
    new_branch=0
  fi

  # smoke trigger: bible.html or any spec changed (or a brand-new branch)
  # REG-1753 (#160) — the smoke grades the PAGE; a bible.html whose only change is its build stamp gives it nothing
  # new to grade (tv/page_delta.py, fail-closed). A spec change still runs it on the name alone.
  if [ "$new_branch" = "1" ] || printf '%s\n' "$changed" | grep -Eq '^tests/.*\.spec\.ts$'; then
    run=1
  elif printf '%s\n' "$changed" | grep -Eq '^bible\.html$' && python3 "$REPO/tv/page_delta.py" --range "$remote_sha..$local_sha" </dev/null; then
    run=1
  fi

  # deploy trigger: pushing main, and a deployable asset changed
  # v755.1 — also ship when the cousin installer (or deploy.sh headers) changes
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$new_branch" = "1" ] || printf '%s\n' "$changed" | grep -Eq '^(bible\.html|art/.*|functions/.*|tv/install-tvd\.ps1|tv/install-tvd\.sh|deploy\.sh)$'; then
      deploy=1
    fi
  fi
done <<< "$_PUSH_REFS"

# ── 1. Smoke gate (blocks the push on failure) ───────────────────────────────
if [ "$run" -eq 0 ]; then
  echo "pre-push: [$(_pp_el)] no page change beyond its build stamp and no spec change in this push — skipping smoke."
elif ! command -v npx >/dev/null 2>&1; then
  echo "pre-push: [$(_pp_el)] WARNING — npx not found on PATH; cannot run the smoke gate."
  echo "          Allowing the push, but please run 'npx playwright test' manually."
else
  echo "pre-push: [$(_pp_el)] running critical-path Playwright smoke (~1-2 min)…"
  echo "          (emergency bypass: git push --no-verify)"
  echo ""
  # v1583 — the smoke gate goes through gate_run like every other gate. It was the ONE left
  # running bare, and the v1582 push showed what that costs: the run was SIGTERMed from outside at
  # test 7 of 64, and the hook answered "smoke FAILED — fix the failing spec(s)". No spec had
  # failed. The advice was confidently wrong, the output was not kept, and the only reason the
  # cause was recoverable at all is that "Terminated: 15" happened to still be on screen.
  #
  # This is the same shape as REG-090 and REG-091, for the third time in two days: a fix (keep the
  # log · bound the wait) applied to some sites and not to the one that mattered next.
  if gate_run "smoke" "npx playwright test ${SMOKE_SPECS[*]} --workers=2" 900 -- \
       npx playwright test "${SMOKE_SPECS[@]}" --workers=2 --reporter=line; then
    echo ""
    echo "pre-push: [$(_pp_el)] smoke GREEN — push allowed."
  else
    rc=$?
    echo ""
    # 143 = SIGTERM. A killed run is NOT a red spec, and telling him to "fix the failing spec"
    # sends him hunting for a bug that does not exist.
    if [ "$rc" -eq 143 ] || [ "$rc" -eq 137 ]; then
      echo "pre-push: [$(_pp_el)] smoke was KILLED (SIGTERM), not failed — no spec went red."
      echo "          Something outside the hook terminated it (a reaped background job, a closed"
      echo "          terminal). Re-run the push in the foreground."
    # v1688 — A MISSING BROWSER IS NOT A RED SPEC, and this hook said it was. On 2026-08-09
    # `~/Library/Caches/ms-playwright/` was EMPTY: every spec died at browserType.launch
    # before executing one line of the app, and the gate printed fifteen spec names under
    # "Fix the failing spec(s)". Read literally it says the app is broken in fifteen places.
    # Nothing was wrong with the app or the specs — the runner had no browser to launch.
    # Same family as the SIGTERM branch above: a gate that cannot RUN must block, but it
    # must never blame the subject for its own missing dependency.
    elif grep -qE "Executable doesn.t exist|Looks like Playwright was just installed|npx playwright install" "$log" 2>/dev/null; then
      echo "pre-push: [$(_pp_el)] smoke could NOT RUN — Playwright has no browser installed."
      echo "          This is a MISSING DEPENDENCY, not a failing spec. Every test in the run"
      echo "          died at browserType.launch before touching the app, so the spec names"
      echo "          above say nothing about your code."
      echo ""
      echo "          Fix it, then push again:   npx playwright install chromium"
      echo ""
      echo "          Full log: ${log}"
    else
      echo "pre-push: [$(_pp_el)] smoke FAILED — push BLOCKED."
      echo "          Fix the failing spec(s), then push again. Full suite: npx playwright test"
    fi
    echo "          Emergency override (NOT recommended): git push --no-verify"
    exit 1
  fi
fi

# ── 2. Publication moved to CI (2026-08-19) ──────────────────────────────────
# This hook used to run deploy.sh here, which meant the live site only ever updated when
# HIS LAPTOP was awake, unlocked, and had CLOUDFLARE_API_TOKEN in ~/.zshenv. It also added
# roughly a minute to every push.
#
# .github/workflows/publish.yml now publishes, and only after smoke + python suites + the
# review agree — so a ship that fails a gate reaches the repo and NOT bull-4-u.com. That is
# the half that matters, because a push to main is what publishes this board.
#
# ⚠ REMOVED ONLY AFTER CI PUBLISHED FOR REAL, not after the job merely went green. Proof:
# workflow_dispatch run 32248211564, deploy job -> "Deployment complete!
# https://e96ae694.d2r-bible.pages.dev ... deploy: live." Taking the working publisher out
# before the new one is proven is how you end up with two halves and no publication.
#
# Two things CI needed that this Mac never did, both found by testing rather than by a real
# ship: Node 22 (wrangler 4.124 refuses to run on 20; this Mac is on 24) and an explicit
# CLOUDFLARE_ACCOUNT_ID (a Pages:Edit token has no Account:Read, so wrangler cannot discover
# the account; local wrangler had it cached in ~/Library/Preferences/.wrangler).
#
# deploy.sh IS STILL THERE and still works. If CI is ever down, publish by hand:
#     bash deploy.sh
if [ "$deploy" -eq 1 ]; then
  echo ""
  echo "pre-push: [$(_pp_el)] deployable change — CI will publish (see the Publish workflow)."
  echo "          if CI is down, publish by hand: bash deploy.sh"
fi

exit 0
