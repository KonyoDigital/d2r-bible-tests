#!/usr/bin/env bash
# pre-push — fast critical-path Playwright smoke before a push is allowed, then
# (on a green push to main) AUTO-DEPLOY the site live to Cloudflare Pages.
#
# This hook is VERSION-CONTROLLED (repo-root hooks/) and activated via
# `core.hooksPath = hooks`. On a fresh clone run `bash hooks/install` once to
# enable it (git config is per-clone and cannot travel in the repo itself).
#
# Why the smoke gate: commits sometimes land on main without the suite being run
# (see REG-001 in BUGS.md — a central artOr() edit load-stormed the calc grid and
# broke 3 specs, only caught by CI after the fact). This gate runs a ~1-2 min
# subset covering the three central helpers (artOr / openDrop / switchTab) + the
# lazy-load invariant, so that class of breakage is caught BEFORE the remote.
#
# Why the auto-deploy: deploys are Mac-only and were a manual step. After the smoke
# gate passes, a push to main that touches bible.html / art / functions publishes
# live via deploy.sh. Ordering note: this runs in pre-push (just before the ref
# reaches the remote), so "live" is the exact state being pushed; if the network
# push were to fail afterward, the next push simply re-deploys the merged state.
# Deploy failure WARNS but never blocks the push — the remote is the source of
# truth for code; going live is a convenience on top.
#
# Scope: smoke only runs when the push touches bible.html or a *.spec.ts; deploy
# only runs for refs/heads/main touching bible.html / art / functions /
# tv/install-tvd.ps1 / deploy.sh. Docs-only pushes skip both.
#
# Emergency bypass (use sparingly):  git push --no-verify
set -u

REPO="$(git rev-parse --show-toplevel)" || exit 1

# v1576 — KEEP THE EVIDENCE. Every gate below used to run with `>/dev/null 2>&1`, so a
# blocked push told you only *that* a suite failed, never *which test*. The output was
# destroyed at the exact moment it became evidence, and the only remedy on offer ("run it
# by hand") is the one thing that cannot recover a FLAKY failure — by the time you re-run,
# it passes and the failing run is gone for good. That happened on the v1575 push: 340
# tests, one of them red, and no way left to learn which.
#
# gate_run <label> <human-rerun-cmd> <timeout-seconds> -- <cmd...>
#   Runs the command with output tee'd to a kept log. On failure prints the last 40 lines
#   (the unittest FAIL/ERROR block lives there) + the log path, then returns 1.
#
# v1578 — AND IT IS TIME-BOUND, because an unbounded gate is not a gate, it is a hang. The v1578
# push sat in tv/test_control.py for TEN MINUTES and was killed from outside; the kept log showed
# one F and one E and then nothing, so the suite hung after failing and gate_run never got to print
# the names. Three re-runs standalone, one after test_agent, and one under a hook-like git
# environment were all 340/340 green, so the cause is still unknown and is recorded as unknown.
# What is fixed is the SHAPE of the failure: a hung gate now dies at its limit and reports as a
# timeout with its log path, instead of blocking the push until a human gives up.
# macOS ships no coreutils `timeout`; perl does the same job with alarm+exec (SIGALRM = 142).
# GATE_RC is written by gate_run so a caller CAN tell a timeout-kill from a red result. No caller
# needs that today, and the one that used to read it never did — see the review-lite note below.
# Kept because gate_run sets it unconditionally; do NOT use it as a substitute for `exit 1`.
GATE_RC=0
GATE_LOG_DIR="${TMPDIR:-/tmp}/d2r-pre-push"
mkdir -p "$GATE_LOG_DIR" 2>/dev/null || GATE_LOG_DIR="/tmp"

gate_run() {
  label="$1"; rerun="$2"; limit="$3"; shift 4   # label, rerun, limit, and the literal --
  # Log name carries the label + pid so concurrent/consecutive pushes never overwrite
  # each other's evidence.
  log="$GATE_LOG_DIR/${label}.$$.log"
  # NOT `if "$@"; then return 0; fi` + `rc=$?` — after an if-block whose branch did not
  # run, $? is the *if statement's* status (0), so the report would claim "exit 0" on a
  # failure. `&& return 0` short-circuits and leaves the command's own code in $?.
  # perl forks and REAPS rather than alarm+exec. With exec, SIGALRM kills the process outright and
  # the shell prints a raw "Alarm clock: 14" into the middle of his push output (a subshell does not
  # ⚠ </dev/null ON THE CHILD (2026-08-19). A pre-push hook receives the ref lines it is judging on
  # STDIN, and the `while read local_ref local_sha remote_ref remote_sha` loop below consumes them
  # to decide what changed. Gate children inherited that same stdin, so any gate that read or
  # drained it would leave that loop at EOF: `run` and `deploy` stay 0, the smoke gate is skipped
  # as "no relevant changes", and the hook exits 0 — a push waved through by a gate that was trying
  # to help. Measured: none of the three current gates touch stdin, so this is LATENT, not live.
  # Closed anyway, because the failure mode is silent and the fix is one redirect.
  # Found by a third-eye review of this hook.
  #
  # hide it — the notice comes from whichever shell waits on the job). Forking lets the parent catch
  # ALRM, TERM the child, and exit 142 deliberately, so a timeout looks like a decision instead of a
  # crash. exit 127 mirrors the shell's own "command not found".
  perl -e 'my $t = shift;
           my $p = fork; die "fork: $!" unless defined $p;
           if (!$p) { exec @ARGV; exit 127 }
           $SIG{ALRM} = sub { kill "TERM", $p; waitpid($p, 0); exit 142 };
           alarm $t; waitpid($p, 0); my $st = $?; alarm 0;
           # A child killed by a SIGNAL puts the signal in the LOW byte and leaves $?>>8 as 0,
           # so the old `exit($? >> 8)` reported a KILLED gate as a PASS. v1582 was SIGTERMed
           # mid-smoke; with this wrapper in front of it the push would have been waved
           # through green. A wrapper that reports success when the thing it wrapped died is
           # worse than no wrapper. 128+signal is what a shell reports, so match it.
           exit(($st & 127) ? 128 + ($st & 127) : ($st >> 8));' "$limit" "$@" </dev/null >"$log" 2>&1 && return 0
  rc=$?
  GATE_RC="$rc"        # the REAL code, for callers that must tell a kill from a red result;
                       # gate_run itself returns 1, so `rc=$?` at the call site sees 1 and a
                       # caller checking for 143 there would never fire. Found by testing the
                       # branch instead of trusting it.
  if [ "$rc" -eq 142 ]; then
    echo "pre-push: ⏱ ${label} HUNG — killed after ${limit}s. Push blocked."
    echo "          Partial output kept at: ${log}"
    echo "          ── last 25 lines before the kill ───────────────────────────"
    tail -25 "$log" | sed 's/^/          /'
    echo "          ────────────────────────────────────────────────────────────"
    return 1
  fi
  echo "pre-push: ❌ ${label} FAILED (exit ${rc}) — push blocked."
  echo "          Reproduce: ${rerun}"
  echo "          Full output kept at: ${log}"
  echo "          ── last 40 lines ───────────────────────────────────────────"
  tail -40 "$log" | sed 's/^/          /'
  echo "          ────────────────────────────────────────────────────────────"
  return 1
}

# v1359 — VISUAL-LOCK gate (instant, pure stdlib, no deps): the tokenized type system
# (font-weights + structure/spacing/line-height on bible.html + tv/control_ui.html) must
# never regress to a raw literal instead of a var(--fw/--hd/--ls/--lh) token. Runs on every
# push; catches drift BEFORE the remote. See LOCKED_TYPE_SYSTEM.md.  (bypass: git push --no-verify)
# ── v1778 — REVIEW BEFORE PUSH, the deterministic half ───────────────────────────────────────────
# Konyo: "yes wire it into pre-push". A git hook cannot invoke the /code-review skill (that is a
# Claude Code command, not a shell tool) and a model review on every push would spend subscription
# calls we now know are finite — so this is the half that IS enforceable: every check is a defect
# class this repo has actually shipped, with a version behind it.
#
# It earned its place on its first run by catching three real things, one of them minutes old:
# a live-state guard watching FILENAMES THAT DO NOT EXIST (chron_autoread.json was never watched),
# the vault sweep's state file isolated by no test at all, and a cap default too small to read one
# reel. The model half stays opt-in: TVD_REVIEW=1 prints an advisory read of the diff.
# 2026-08-19 — THIS GATE COULD NOT BLOCK A PUSH, AND NOTHING SAID SO.
# On failure it set GATE_RC=1 and carried on. `$GATE_RC` is never read anywhere in this file —
# grep it: assigned at three places, consumed at none. So review-lite has been ADVISORY since it
# was written, while its two siblings below (visual-lock, boss-portraits) both `exit 1` on the
# same shape. Its own comment above says it earned its place by catching three real defects on
# its first run; every one it caught after that was a line in a log nobody had to act on.
# A gate that reports and cannot refuse is the failure this repo has the most scars for.
# Found by a third-eye review of the hook. Verified before arming: `python3 tv/review_lite.py`
# exits 0 today ("review-lite clean — 6 state paths, chronicle tolerances, caps, reader guards"),
# so making it block refuses nothing that is currently green.
# ── v1966 — A COMMIT THAT NAMES A VERSION MUST CARRY THAT VERSION'S STAMPS ───────────────────────
# Konyo's rule was already written down — "A vNNNN IS A SHIP, NOT A COMMIT: number ONLY commits that
# bump the four stamps" — and nothing enforced it. On 2026-08-22 `bump_version.py v1964` REFUSED
# ("apostrophe in note/name would break the single-quoted D2R_BUILD literal"; the note said read's),
# the refusal was piped through `tail -3` in a background command and never read, and the commit went
# out titled "v1963 + v1964" with all four stamps still at v1963. Code correct, every gate and CI lane
# green — only the claim was false, and the board reported one version behind what it carried.
#
# It checks the HIGHEST version the subject names, not the first: that subject named two, and a
# first-match gate would have found v1963, matched the stamps and agreed with the mistake.
# Silent on commits that name no version — those are exactly the ones his rule says not to number.
if ! gate_run "version-stamp" "python3 tv/version_stamp_gate.py" 30 -- \
     python3 "$REPO/tv/version_stamp_gate.py"; then
  echo "          ↑ the commit subject claims a version the four stamps do not carry."
  exit 1
fi

if ! gate_run "review-lite" "python3 tv/review_lite.py" 120 -- python3 "$REPO/tv/review_lite.py"; then
  echo "          ↑ a live-state path, tolerance, cap or reader guard drifted from what the code"
  echo "            actually does. Fix it, or say why it is now correct, then push again."
  exit 1
fi

if ! gate_run "visual-lock" "python3 visual_lock_invariant.py   (see LOCKED_TYPE_SYSTEM.md)" 120 -- \
     python3 "$REPO/visual_lock_invariant.py"; then
  echo "          ↑ a raw font-weight/spacing literal crept in (or a token went missing)."
  exit 1
fi
echo "pre-push: ✅ visual-lock intact."

# v1643 — BOSS-PORTRAIT gate (instant, pure stdlib): the twelve boss thumbnails must still be the
# BYTES A HUMAN OPENED (art/boss_portraits.manifest.json pins each sha256 next to a sentence saying
# what that human saw), and bible.html's BOSS_PORTRAIT map must serve exactly those files. Mephisto
# shipped as a blue soulstone and Diablo as a leather book for seven weeks (v269 → v1636) with every
# automated check green — the path resolved, naturalWidth was > 0 — so this gate exists because "it
# loads" was never evidence that it is the right picture.
#
# It is here because REG-130: the script had ZERO callers. It passed its own tests and guarded
# nothing. A checker nobody has watched fail from its wired path is not known to be a gate.
if ! gate_run "boss-portraits" "python3 art/verify_boss_portraits.py   (--list to see what each depicts)" 120 -- \
     python3 "$REPO/art/verify_boss_portraits.py"; then
  echo "          ↑ a boss thumbnail is not the picture a human blessed, or bible.html and the"
  echo "            manifest disagree. OPEN the image before re-blessing any hash."
  exit 1
fi
echo "pre-push: ✅ boss portraits are the pictures a human opened, and bible.html serves them."

# v877 — TV FAST LANE: any tv/*.py in the push runs both python suites (~10s, no Playwright,
# no Chromium, no Mac load). The physically unskippable gate KONYO_WORKFLOW step 12 asks for.
if git diff --name-only @{push}.. 2>/dev/null | grep -qE '^tv/.*\.py$'; then
  echo "pre-push: tv/ python touched — running the agent+control suites…"
  if ! gate_run "test_agent" "python3 tv/test_agent.py" 600 -- python3 "$REPO/tv/test_agent.py"; then
    exit 1
  fi
  if ! gate_run "test_control" "python3 tv/test_control.py" 600 -- python3 "$REPO/tv/test_control.py"; then
    exit 1
  fi
  # v1578 — the TZ panel's DATA (67 zones -> game-extracted art + the game's own density/level, and
  # the tiering that greys a zone out). Cheap, pure stdlib, and it guards a surface Konyo looks at
  # every hour: a missing art key is a broken image on his TV that the browser reports to nobody.
  if ! gate_run "test_tz_art" "python3 tv/test_tz_art.py" 120 -- python3 "$REPO/tv/test_tz_art.py"; then
    exit 1
  fi
  # 2026-08-20 — THE CHRONICLE GATES RAN ONLY IN CI, AND ONE SAT RED FOR NINE VERSIONS.
  # run_gates.py runs 30 gates; this hook ran three. test_chronicle_seal extracts the seal loop
  # straight out of control_app.py and execs it, so v1830 adding the reader stamp to a seal broke it
  # instantly — and nothing local said a word, because tv-tests.yml is the only thing that runs it.
  # v1830..v1838 all shipped over a red gate nobody was looking at.
  # Both suites are pure stdlib and finish in well under a second together, so the fast lane stays
  # fast. [[feedback-ci-verdict-before-seal]]
  if ! gate_run "test_chronicle_retro" "python3 tv/test_chronicle_retro.py" 120 -- \
       python3 "$REPO/tv/test_chronicle_retro.py"; then
    exit 1
  fi
  if ! gate_run "test_chronicle_seal" "python3 tv/test_chronicle_seal.py" 120 -- \
       python3 "$REPO/tv/test_chronicle_seal.py"; then
    exit 1
  fi
  echo "pre-push: ✅ tv suites green."
  # v938.6 — console DEMO gate: when the console UI changed and the app is UP, the
  # demonstration journeys must pass. App down → skip with a note (never block on an environment
  # the push didn't break). Konyo's "full test system" law.
  #
  # ⚠ v1930 — A SKIP THAT WHISPERS IS A GATE THAT ISN'T THERE. This fires only on a
  # tv/control_ui.html diff with the app up. v1930 was the first push in a while to satisfy both,
  # and it caught J9 failing — which bisection then showed had ALSO been failing on v1924, v1925,
  # v1926, v1927, v1928 and v1929, every one of which pushed clean because none touched that file.
  # Seven versions, a real red gate, and nothing said a word.
  #
  # The trigger is deliberately narrow and stays narrow: widening it would block pushes on an
  # environment the push did not break, which is the thing v938.6 was careful about. What changes
  # is that a SKIP is now LOUD and says WHY and HOW LONG it has been skipping, because "we chose
  # not to run this" and "this passed" must never look the same.
  # [[feedback-blind-fixture-green-gate]]
  _demo_touched=0
  # v2120 — LOOK AT THE WHOLE PUSH, NOT THE LAST COMMIT. This asked `git log -1`, so a push
  # carrying a UI commit FOLLOWED by a test-only commit reported "tv/control_ui.html is unchanged"
  # and skipped — which is exactly what happened on the v2120 push: the UI changed in that push and
  # the gate said it had not. The range is what is actually being shipped.
  _range=""
  if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    _range="$(git rev-parse --abbrev-ref '@{u}')..HEAD"
  elif git rev-parse --verify origin/main >/dev/null 2>&1; then
    _range="origin/main..HEAD"
  fi
  if git diff --cached --name-only 2>/dev/null | grep -q "tv/control_ui.html"; then
    _demo_touched=1
  elif [ -n "$_range" ] && git diff --name-only "$_range" 2>/dev/null | grep -q "tv/control_ui.html"; then
    _demo_touched=1
  elif [ -z "$_range" ] && git log -1 --name-only --pretty=format: 2>/dev/null | grep -q "tv/control_ui.html"; then
    _demo_touched=1
  fi
  if [ "$_demo_touched" = "1" ]; then
    if curl -s -m 2 -o /dev/null http://127.0.0.1:17772/api/status; then
      if gate_run "console-demos" "node tv/demo_console.mjs" 180 -- node "$REPO/tv/demo_console.mjs"; then
        echo "pre-push: ✅ console demos green."
      else
        exit 1
      fi
    else
      # ── v2119 — A SKIP IS NOT A PASS, AND NOBODY IS COMING TO FIX IT ────────────────────────
      # v1930 made this skip LOUD, which was right and was not enough: a loud skip still shipped
      # UI nobody had looked at, because the remedy ("start TV DIABLO and re-push") required a
      # person to be sitting there. Konyo's ruling, twice: "i dont get why you didnt open it
      # yourself the console.. you have authorization to do it.. next time dont wait for me", and
      # then "you can relaunch and verify you DONT NEED TO WAIT FOR ME TO DO IT ... i want it
      # locked as a workflow too.. so you odnt forget it."
      #
      # So the gate starts its OWN headless console and runs. Two safety rules, both load-bearing:
      #   · it only ever starts one when the port is ALREADY SILENT — it never takes over his
      #     window, and it never rebinds a port something else holds [[process-port-discipline]]
      #   · it stops ONLY the pid it started, by pid, never by name. `pkill -f` cannot tell his
      #     console from ours and has cost him a live window before.
      # A headless console cannot capture the GAME (no Screen Recording grant from this shell),
      # which does not matter here: J1-J9 exercise the UI and its routes, not the capture.
      echo "pre-push: ▶  :17772 is silent — starting a headless console for the gate (his window is not touched)."
      _own_console=""
      # A run that dies between here and the stop below LEAKS a console that survives for days.
      # It binds whatever port is free — one was found alive on :17994 at 1d11h — so a leak is
      # invisible on :17772 and nothing ever notices. Reap our own leaked pid first, BY PID, and
      # only after confirming that pid really is a gate console (a recycled pid must not be hit).
      _stale=$(cat /tmp/tvd_gate_console.pid 2>/dev/null || true)
      if [ -n "$_stale" ] && ps -p "$_stale" >/dev/null 2>&1; then
        case "$(ps -o args= -p "$_stale" 2>/dev/null)" in
          *control_app.py*--no-open*)
            kill "$_stale" 2>/dev/null || true
            echo "pre-push: 🧹 reaped a leaked gate console (pid $_stale) left by an earlier run." ;;
        esac
      fi
      rm -f /tmp/tvd_gate_console.pid
      ( cd "$REPO/tv" && nohup python3 control_app.py --no-open >/tmp/tvd_gate_console.log 2>&1 & echo $! > /tmp/tvd_gate_console.pid ) || true
      _own_console=$(cat /tmp/tvd_gate_console.pid 2>/dev/null || true)
      # and stop it on EVERY exit path — a failing gate below exits before the explicit kill
      trap '"'"'if [ -n "$_own_console" ]; then kill "$_own_console" 2>/dev/null || true; rm -f /tmp/tvd_gate_console.pid; fi'"'"' EXIT INT TERM
      _up=0
      for _i in $(seq 1 40); do
        sleep 1
        if curl -s -m 2 -o /dev/null http://127.0.0.1:17772/api/status; then _up=1; break; fi
      done
      if [ "$_up" = "1" ]; then
        if gate_run "console-demos" "node tv/demo_console.mjs" 180 -- node "$REPO/tv/demo_console.mjs"; then
          echo "pre-push: ✅ console demos green (on a console this gate started)."
          _demo_rc=0
        else
          _demo_rc=1
        fi
      else
        echo "pre-push: ❌ could not start a console on :17772 — see /tmp/tvd_gate_console.log"
        echo "           This is a FAILURE, not a skip: the UI changed and nothing verified it."
        _demo_rc=1
      fi
      # stop ONLY what we started, by pid
      if [ -n "$_own_console" ]; then
        kill "$_own_console" 2>/dev/null || true
        rm -f /tmp/tvd_gate_console.pid
        _own_console=""
      fi
      [ "$_demo_rc" = "0" ] || exit 1
    fi
  else
    # How many pushes have gone by without this gate running? Cheap, and it turns an invisible
    # skip into a number he can watch grow.
    _since=$(git log --format=%H -30 2>/dev/null | while read -r _c; do
               if git show --name-only --pretty=format: "$_c" 2>/dev/null | grep -q "tv/control_ui.html"; then break; fi
               echo x
             done | wc -l | tr -d ' ')
    echo "pre-push: ⏭  console demos not run — tv/control_ui.html is unchanged (${_since} commit(s) since it last was)."
  fi
fi
cd "$REPO" || exit 1

SMOKE_SPECS=(
  tests/01_smoke.spec.ts
  tests/v71_d2art.spec.ts
  tests/v74_material_search.spec.ts
  tests/v80_endgame_relics.spec.ts
  tests/v535_ux_simulation.spec.ts   # v535 — USER-EXPERIENCE sims: drive the rendered UI (tabs/cards/buttons),
                                     # catch render-vs-logic drift + cross-tab platform sync. Konyo's ask to
                                     # bake UX simulations into the autonomous-loop workflow, not just CI.
  tests/v604_forge_coverage_invariant.spec.ts   # v604 — NO SILENT WORDS: every unmade word tasked in
                                     # forgeScan AND rendered in the Forge DOM + the Katar-scenario UX sim
                                     # (register an exact-fit base -> its word lands ON that base, visibly).
  tests/v616_class_restriction_invariant.spec.ts   # v616 — GAME-RULE LOCK: full-catalog sweep — class-
                                     # gated words (Exile=auric, Pattern/Chaos=claws, circlets host
                                     # nothing) can never leak onto illegal bases; art homes stay legal.
  tests/v630_exclusivity_reservation.spec.ts   # v630 — EXCLUSIVITY RESERVATION: a class-locked word
                                     # (Exile) claims its owned host first; broad words (Phoenix) re-task
                                     # with the earmark narration; readiness order preserved among peers.
  tests/v631_promote_unknown_bases.spec.ts   # v631 — '(Nos)' reads stuck in unknownReads that exact-fit
                                     # an unmade word are PROMOTED to owned forge bases at boot/scan-finish
                                     # (Konyo's Heavy Crossbow → Mist); junk reads stay in the ledger.
  tests/v635_ladder_profile.spec.ts   # v635 — LADDER ACCOUNT bleed-proof invariant: the storage router
                                     # keeps main byte-identical while the ladder profile lives a full
                                     # forge life (make-now → created → consume) under L· keys.
  tests/v636_ladder_closure.spec.ts   # v636 — the closure-swarm locks: profile-scoped wipe, SEEN pre-seed,
                                     # ladder consistency (_rwLadderBlocked/rwVerify/rwSetLadderMode),
                                     # per-profile Backup&Share, and the no-silent sweep INSIDE ladder.
  tests/v637_oneway_inheritance.spec.ts   # v638 — SHARED CHRONICLE: one grail ledger both ways (a forge
                                     # counts from either account); vaults/tallies never cross; the
                                     # v637-era orphaned L· chronicle reconciles once, union-only.
  tests/v644_grail_ledger.spec.ts   # v644 — THE GRAIL LEDGER: every unique/piece one-click tickable,
                                     # dated found-chronicle (d2r_foundLog), undo-last, tallies both ways.
)

ZERO="0000000000000000000000000000000000000000"
run=0       # 1 = run the smoke gate
deploy=0    # 1 = auto-deploy after a green push

# stdin lines (single pass — bash 3.2 has no mapfile): set BOTH run and deploy,
# never break early so every ref is considered.
# Each line: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion — nothing to do

  if [ "$remote_sha" = "$ZERO" ]; then
    changed=""                                     # new remote branch — no base to diff
    new_branch=1
  else
    changed="$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null)"
    new_branch=0
  fi

  # smoke trigger: bible.html or any spec changed (or a brand-new branch)
  if [ "$new_branch" = "1" ] || printf '%s\n' "$changed" | grep -Eq '^(bible\.html|tests/.*\.spec\.ts)$'; then
    run=1
  fi

  # deploy trigger: pushing main, and a deployable asset changed
  # v755.1 — also ship when the cousin installer (or deploy.sh headers) changes
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$new_branch" = "1" ] || printf '%s\n' "$changed" | grep -Eq '^(bible\.html|art/.*|functions/.*|tv/install-tvd\.ps1|tv/install-tvd\.sh|deploy\.sh)$'; then
      deploy=1
    fi
  fi
done

# ── 1. Smoke gate (blocks the push on failure) ───────────────────────────────
if [ "$run" -eq 0 ]; then
  echo "pre-push: no bible.html / spec changes in this push — skipping smoke."
elif ! command -v npx >/dev/null 2>&1; then
  echo "pre-push: WARNING — npx not found on PATH; cannot run the smoke gate."
  echo "          Allowing the push, but please run 'npx playwright test' manually."
else
  echo "pre-push: running critical-path Playwright smoke (~1-2 min)…"
  echo "          (emergency bypass: git push --no-verify)"
  echo ""
  # v1583 — the smoke gate goes through gate_run like every other gate. It was the ONE left
  # running bare, and the v1582 push showed what that costs: the run was SIGTERMed from outside at
  # test 7 of 64, and the hook answered "smoke FAILED — fix the failing spec(s)". No spec had
  # failed. The advice was confidently wrong, the output was not kept, and the only reason the
  # cause was recoverable at all is that "Terminated: 15" happened to still be on screen.
  #
  # This is the same shape as REG-090 and REG-091, for the third time in two days: a fix (keep the
  # log · bound the wait) applied to some sites and not to the one that mattered next.
  if gate_run "smoke" "npx playwright test ${SMOKE_SPECS[*]} --workers=2" 900 -- \
       npx playwright test "${SMOKE_SPECS[@]}" --workers=2 --reporter=line; then
    echo ""
    echo "pre-push: smoke GREEN — push allowed."
  else
    rc=$?
    echo ""
    # 143 = SIGTERM. A killed run is NOT a red spec, and telling him to "fix the failing spec"
    # sends him hunting for a bug that does not exist.
    if [ "$rc" -eq 143 ] || [ "$rc" -eq 137 ]; then
      echo "pre-push: smoke was KILLED (SIGTERM), not failed — no spec went red."
      echo "          Something outside the hook terminated it (a reaped background job, a closed"
      echo "          terminal). Re-run the push in the foreground."
    # v1688 — A MISSING BROWSER IS NOT A RED SPEC, and this hook said it was. On 2026-08-09
    # `~/Library/Caches/ms-playwright/` was EMPTY: every spec died at browserType.launch
    # before executing one line of the app, and the gate printed fifteen spec names under
    # "Fix the failing spec(s)". Read literally it says the app is broken in fifteen places.
    # Nothing was wrong with the app or the specs — the runner had no browser to launch.
    # Same family as the SIGTERM branch above: a gate that cannot RUN must block, but it
    # must never blame the subject for its own missing dependency.
    elif grep -qE "Executable doesn.t exist|Looks like Playwright was just installed|npx playwright install" "$log" 2>/dev/null; then
      echo "pre-push: smoke could NOT RUN — Playwright has no browser installed."
      echo "          This is a MISSING DEPENDENCY, not a failing spec. Every test in the run"
      echo "          died at browserType.launch before touching the app, so the spec names"
      echo "          above say nothing about your code."
      echo ""
      echo "          Fix it, then push again:   npx playwright install chromium"
      echo ""
      echo "          Full log: ${log}"
    else
      echo "pre-push: smoke FAILED — push BLOCKED."
      echo "          Fix the failing spec(s), then push again. Full suite: npx playwright test"
    fi
    echo "          Emergency override (NOT recommended): git push --no-verify"
    exit 1
  fi
fi

# ── 2. Publication moved to CI (2026-08-19) ──────────────────────────────────
# This hook used to run deploy.sh here, which meant the live site only ever updated when
# HIS LAPTOP was awake, unlocked, and had CLOUDFLARE_API_TOKEN in ~/.zshenv. It also added
# roughly a minute to every push.
#
# .github/workflows/publish.yml now publishes, and only after smoke + python suites + the
# review agree — so a ship that fails a gate reaches the repo and NOT bull-4-u.com. That is
# the half that matters, because a push to main is what publishes this board.
#
# ⚠ REMOVED ONLY AFTER CI PUBLISHED FOR REAL, not after the job merely went green. Proof:
# workflow_dispatch run 32248211564, deploy job -> "Deployment complete!
# https://e96ae694.d2r-bible.pages.dev ... deploy: live." Taking the working publisher out
# before the new one is proven is how you end up with two halves and no publication.
#
# Two things CI needed that this Mac never did, both found by testing rather than by a real
# ship: Node 22 (wrangler 4.124 refuses to run on 20; this Mac is on 24) and an explicit
# CLOUDFLARE_ACCOUNT_ID (a Pages:Edit token has no Account:Read, so wrangler cannot discover
# the account; local wrangler had it cached in ~/Library/Preferences/.wrangler).
#
# deploy.sh IS STILL THERE and still works. If CI is ever down, publish by hand:
#     bash deploy.sh
if [ "$deploy" -eq 1 ]; then
  echo ""
  echo "pre-push: deployable change — CI will publish (see the Publish workflow)."
  echo "          if CI is down, publish by hand: bash deploy.sh"
fi

exit 0
